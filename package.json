{
  "name": "algorik-platform",
  "private": true,
  "description": "Algorik \u2014 shared frontend foundation. The Rust workspace is governed by Cargo.toml; this file governs only the browser layer.",
  "workspaces": [
    "packages/*",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "typecheck": "npm run typecheck --workspace frontend",
    "test": "npm run test --workspace frontend",
    "tokens": "node scripts/generate-theme-css.mjs",
    "tokens:check": "node scripts/generate-theme-css.mjs --check"
  }
}
