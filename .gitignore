/backend/target
**/*.rs.bk
Cargo.lock.orig

# Local platform state written by the demo / dev runtime
/.qip-state/
/data/local/
/artifacts/
*.jsonl.tmp

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfvars.local
# Terraform merges `override.tf` and `*_override.tf` over the rest of the
# configuration automatically, so a committed one silently changes what every
# apply does. The usual local use is swapping the GCS backend for a local one
# to run `plan` without credentials — committing that would point production
# state at whichever workstation ran it last.
override.tf
*_override.tf

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
node_modules/

# Worker gateway spend ledger — local, never committed.
.worker-spend.jsonl

# Development identity stores — local users and sessions, never committed.
.algorik-dev/
.algorik-test-identity/

# Compiled Python bytecode — build output, never source.
__pycache__/

# Terraform saved plans — resolved configuration, never committed.
*.tfplan

# Trunk local state — only trunk.yaml and shared config are source. No
# trailing slashes: trunk creates these as symlinks into its cache, and a
# dir-only pattern does not match a symlink.
.trunk/logs
.trunk/actions
.trunk/out
.trunk/tools
.trunk/plugins
.trunk/notifications

# Staged by scripts/deploy-frontends.sh for the duration of a Cloud Build
# submit and removed by its exit trap; the sources of truth live in
# infrastructure/docker/. Committing a copy would fork them.
/frontend/Dockerfile
/frontend/landing/Dockerfile

# Per-agent git worktrees created by the Agent tool's isolation:"worktree"
# mode. Each is a scratch checkout for one background agent's branch; the
# branch itself is what gets pushed, so committing the worktree directory
# would duplicate history that already exists on its branch.
/.claude/worktrees/
