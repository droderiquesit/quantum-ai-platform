#!/usr/bin/env python3
"""Read one Secret Manager payload and write it to a file. Nothing else.

The execution node's startup script
(`infrastructure/terraform/modules/execution-node/templates/startup.sh.tftpl`)
refuses to start any unit unless `/usr/local/bin/qip-fetch-secret` is present
and executable, and its comment says exactly why this file exists rather than
a line of shell:

    the image must ship a helper that reads a Secret Manager payload and
    writes it to a file — this script deliberately does not assemble one out
    of curl and a JSON parser that may not be installed.

So: one process, one language, the standard library only. The token is
obtained, used and discarded inside this process. It is never an argument, so
it is never in `ps`; never an environment value, so it is never in
`/proc/<pid>/environ`, in a child process, or in a crash dump; and never
written to a file, so there is nothing on disk to read afterwards. That is the
same rule the rest of the platform follows for credential material, applied to
the one place on a node where a credential is in flight.

The payload is written straight to a file created `O_EXCL` at mode 0600 and
renamed into place, so no window exists in which it is readable by anything
but root. The caller then chowns it to the service user and chmods it 0400.

Usage, and the startup script uses exactly this form:

    qip-fetch-secret <project-id> <secret-id> <destination> [version]

`version` defaults to `latest`. Every failure exits non-zero with a message
naming what to do, and writes nothing: a node that could not read its capital
envelope key must not start, and a truncated key file would be a node that
starts and then cannot verify a grant.

Deliberately not here: any retry against a 403. A permission error is a
binding that was not made, and retrying it produces a slow failure instead of
a fast one.
"""

import base64
import json
import os
import sys
import urllib.error
import urllib.request

METADATA_TOKEN_URL = (
    "http://169.254.169.254/computeMetadata/v1/"
    "instance/service-accounts/default/token"
)
SECRET_MANAGER = "https://secretmanager.googleapis.com/v1"

# Every call that leaves this process has one. A boot that hangs on a socket
# is a machine the instance group never marks unhealthy, because it never got
# far enough to bind a health port.
TIMEOUT_SECONDS = 20


def fail(message):
    """Refuse, naming what to do instead."""
    sys.stderr.write("qip-fetch-secret: %s\n" % message)
    raise SystemExit(1)


def _get_json(url, headers):
    request = urllib.request.Request(url, headers=headers, method="GET")
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT_SECONDS) as response:
            return json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as error:
        # The body of a Google API error names the permission or the resource.
        # Losing it here would leave an operator with a bare status code.
        detail = error.read().decode("utf-8", "replace").strip()
        raise SystemExit(
            "qip-fetch-secret: %s answered HTTP %d: %s\n" % (url, error.code, detail)
        )
    except urllib.error.URLError as error:
        raise SystemExit(
            "qip-fetch-secret: could not reach %s (%s). The node has no route to "
            "the internet by design; Secret Manager is reached over the "
            "restricted VIP through private Google access, which is the "
            "subnet setting and the one egress rule modules/execution-node "
            "creates.\n" % (url, error.reason)
        )


def access_token():
    """The instance's own token, from the metadata server.

    Plaintext HTTP to a link-local address: the metadata server is not on the
    network and no TLS stack is involved, which is why this works before the
    egress proxy's unit has been installed.
    """
    payload = _get_json(METADATA_TOKEN_URL, {"Metadata-Flavor": "Google"})
    token = payload.get("access_token")
    if not token:
        fail(
            "the metadata server returned no access_token. The instance is "
            "running without a service account, or the account has no scope. "
            "modules/execution-node attaches one; a machine created outside it "
            "has none."
        )
    return token


def payload_bytes(project, secret, version, token):
    url = "%s/projects/%s/secrets/%s/versions/%s:access" % (
        SECRET_MANAGER,
        project,
        secret,
        version,
    )
    response = _get_json(url, {"Authorization": "Bearer %s" % token})
    data = response.get("payload", {}).get("data")
    if data is None:
        fail(
            "%s/%s has no payload data. A secret container Terraform created "
            "and nothing ever wrote a version to reads exactly like this; "
            "scripts/bootstrap-deploy.sh seeds the self-generated values and "
            "a vendor credential is added by a person." % (secret, version)
        )
    try:
        return base64.b64decode(data, validate=True)
    except (ValueError, TypeError):
        fail("%s/%s returned a payload that is not base64" % (secret, version))


def write_private(destination, content):
    """Create the file readable by root alone, then rename it into place.

    `O_EXCL` rather than a truncate: a destination that already exists is a
    boot that ran twice or a file somebody else put there, and overwriting it
    would hide both. The rename is what makes the visible file complete or
    absent and never half-written.
    """
    temporary = "%s.partial" % destination
    try:
        os.unlink(temporary)
    except FileNotFoundError:
        pass
    handle = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        os.write(handle, content)
        os.fsync(handle)
    finally:
        os.close(handle)
    os.replace(temporary, destination)


def main(argv):
    if len(argv) not in (4, 5):
        fail(
            "usage: qip-fetch-secret <project-id> <secret-id> <destination> "
            "[version]"
        )
    project, secret, destination = argv[1], argv[2], argv[3]
    version = argv[4] if len(argv) == 5 else "latest"
    for name, value in (("project-id", project), ("secret-id", secret)):
        if not value:
            fail("%s is empty" % name)
    directory = os.path.dirname(destination) or "."
    if not os.path.isdir(directory):
        fail(
            "%s does not exist. The startup script mounts the tmpfs the "
            "secrets are written to before calling this." % directory
        )
    content = payload_bytes(project, secret, version, access_token())
    if not content:
        fail(
            "%s/%s is an empty payload. A node that started on an empty "
            "capital envelope key would fail to verify every grant it was "
            "sent, with an error naming the grant rather than the key."
            % (secret, version)
        )
    write_private(destination, content)
    # The path, never the value. A helper that echoed what it fetched would
    # put the key in the boot log, which is exactly where a credential is
    # read by everyone who can read a serial console.
    sys.stderr.write(
        "qip-fetch-secret: wrote %s from %s/%s (%d bytes)\n"
        % (destination, secret, version, len(content))
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
