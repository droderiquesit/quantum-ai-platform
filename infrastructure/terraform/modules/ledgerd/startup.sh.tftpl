#!/bin/bash
# qip-ledgerd startup.
#
# Rendered by Terraform's `templatefile`, which escapes nothing. Every
# substitution is validated in variables.tf to a closed character set:
# `account_id` and `fabric_consumer_group` are lowercase letters, digits and
# '-', `listen_port` is a number. A new substitution needs a validation in
# the same diff.
#
# Fail closed: a ledger that cannot prove its archive is on its own disk does
# not start, because a ledger writing to the boot disk loses its postings
# with the machine.

set -euo pipefail

archive_device=/dev/disk/by-id/google-qip-ledger
archive_path=/var/lib/qip/ledger

internal_ip="$(curl -fs -H "Metadata-Flavor: Google" \
  http://metadata.google.internal/computeMetadata/v1/instance/network-interfaces/0/ip)"
case "$internal_ip" in
  ''|*[!0-9.]*) echo "refusing to start: no internal address from the metadata server" >&2; exit 1 ;;
esac

for _ in $(seq 1 30); do
  [ -b "$archive_device" ] && break
  sleep 2
done
[ -b "$archive_device" ] || { echo "refusing to start: no archive disk at $archive_device" >&2; exit 1; }

# Formatted only when it carries no filesystem: a replaced machine resumes
# from the archive it is given, never erases it.
if [ -z "$(blkid -o value -s TYPE "$archive_device" || true)" ]; then
  mkfs.ext4 -q "$archive_device"
fi
install -d -m 0700 "$archive_path"
if ! mountpoint -q "$archive_path"; then
  mount -o noatime "$archive_device" "$archive_path"
fi
mountpoint -q "$archive_path" || { echo "refusing to start: $archive_path is not mounted" >&2; exit 1; }

# The composition root reads its configuration from the environment
# (qip-ledgerd/src/config.rs); the unit reads this file. No credential is in
# it: the book name and the consumer group are configuration.
install -d -m 0700 /etc/qip
cat > /etc/qip/ledgerd.env <<EOF
QIP_LEDGER_ACCOUNT_ID=${account_id}
QIP_LEDGER_ARCHIVE_PATH=$archive_path
QIP_LEDGER_LISTEN_ADDR=$internal_ip:${listen_port}
QIP_LEDGER_FABRIC_CONSUMER_GROUP=${fabric_consumer_group}
EOF
chmod 0600 /etc/qip/ledgerd.env

if ! systemctl cat qip-ledgerd.service >/dev/null 2>&1; then
  echo "refusing to start: the boot image carries no qip-ledgerd.service" >&2
  exit 1
fi
systemctl restart qip-ledgerd.service
echo "qip-ledgerd started on $internal_ip:${listen_port}, archive at $archive_path"
