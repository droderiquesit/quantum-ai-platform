#!/bin/bash
# Event Fabric Broker startup script.
#
# ADR 0100 §1: the broker runs on a dedicated Compute Engine machine with no
# external address. Rendered by Terraform's `templatefile`, which escapes
# nothing: every substitution below is either base64 (a closed alphabet), a
# number, or a device path the module's validation restricts to a closed
# character set. A new substitution needs a validation in the same diff.
#
# Fail closed throughout. This script used to end most steps in `|| true`,
# including the mount — so a journal that failed to mount left the broker
# writing its fsynced, acknowledged records to the boot disk, which is
# replaced with the machine. A broker that cannot prove where its journal
# is does not start.

set -euo pipefail

journal_device='${qip_storage_journal_device}'
journal_mount=/var/lib/qip/journal

# FABRIC-089: no external address, checked rather than assumed.
external_ip="$(curl -fs -H "Metadata-Flavor: Google" \
  http://metadata.google.internal/computeMetadata/v1/instance/network-interfaces/0/access-configs/0/external-ip || true)"
if [ -n "$external_ip" ] && [ "$external_ip" != "0.0.0.0" ]; then
  echo "refusing to start: the broker has an external address ($external_ip), which FABRIC-089 forbids" >&2
  exit 1
fi
internal_ip="$(curl -fs -H "Metadata-Flavor: Google" \
  http://metadata.google.internal/computeMetadata/v1/instance/network-interfaces/0/ip)"
case "$internal_ip" in
  ''|*[!0-9.]*) echo "refusing to start: no internal address from the metadata server" >&2; exit 1 ;;
esac

# The journal disk. Waited for, because udev may not have linked it yet.
for _ in $(seq 1 30); do
  [ -b "$journal_device" ] && break
  sleep 2
done
[ -b "$journal_device" ] || { echo "refusing to start: no journal device at $journal_device" >&2; exit 1; }

# Formatted only when it carries no filesystem at all. This used to format
# whenever a marker file on the *boot* disk was absent — so a machine
# replaced from the template, with a fresh boot disk and the old journal
# attached, would have erased the journal it was meant to resume from.
if [ -z "$(blkid -o value -s TYPE "$journal_device" || true)" ]; then
  echo "journal device $journal_device carries no filesystem; creating one"
  mkfs.ext4 -q "$journal_device"
fi

install -d -m 0700 "$journal_mount"
if ! mountpoint -q "$journal_mount"; then
  mount -o noatime "$journal_device" "$journal_mount"
fi
mountpoint -q "$journal_mount" || { echo "refusing to start: $journal_mount is not mounted" >&2; exit 1; }

# Configuration as files, readable by root alone, and an environment file
# naming them for the unit. Neither carries a credential: the catalogue and
# the broker's settings are ADR 0100 §5's committed configuration.
install -d -m 0700 /etc/qip
echo '${qip_events_config}' | base64 -d > /etc/qip/events.json
echo '${qip_fabricd_config}' | base64 -d > /etc/qip/fabricd.json
chmod 0600 /etc/qip/events.json /etc/qip/fabricd.json
cat > /etc/qip/fabricd.env <<EOF
QIP_EVENT_FABRIC_DATA_DIR=$journal_mount
QIP_EVENT_FABRIC_CATALOGUE=/etc/qip/events.json
QIP_EVENT_FABRIC_LISTEN=$internal_ip:${broker_port}
EOF
chmod 0600 /etc/qip/fabricd.env

# The binary is the boot image's, under its own unit. An image without the
# unit is an image that cannot run a broker, and that is said here rather
# than discovered by a client that cannot connect.
if ! systemctl cat qip-fabricd.service >/dev/null 2>&1; then
  echo "refusing to start: the boot image carries no qip-fabricd.service" >&2
  exit 1
fi
systemctl restart qip-fabricd.service
echo "qip-fabricd started on $internal_ip:${broker_port}, journal at $journal_mount"
