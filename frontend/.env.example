# Where the Rust platform API lives. The browser never talks to it directly:
# every request is proxied by this app's own route handlers, so the token below
# stays server-side and no CORS configuration is required of the backend.
QIP_API_BASE_URL=http://127.0.0.1:8080

# Bearer credential presented upstream. Roles are per route: /health needs
# Monitor, most reads need Viewer, POST /cycle needs Analyst and the kill switch
# needs Operator. Leave unset to call an API that runs without authentication.
QIP_API_TOKEN=

# How long a proxied REST call may take before the gateway reports 504.
QIP_API_TIMEOUT_MS=10000

# Shown in the chrome so an operator can tell one deployment from another.
NEXT_PUBLIC_QIP_ENVIRONMENT=local
