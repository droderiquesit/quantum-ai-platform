{
  "source_id": "alpaca-daily-bars",
  "provider": "Alpaca Market Data (data.alpaca.markets), daily bars from the IEX feed. An account is required; the credential is named here as a deployment secret and never carried. A candidate under ADR 0034 whose terms have not been read: the class here is the fail-closed floor, and qip-data-finder's catalogue refuses the source until they are.",
  "asset_class": "equities",
  "region": "north_america",
  "protocol": "rest",
  "schema": {
    "version": "1.0",
    "required_fields": [
      { "path": "bars", "kind": "object" }
    ],
    "unknown_fields": "ignore"
  },
  "auth": {
    "scheme": "header",
    "header": "apca-api-secret-key",
    "secret": { "variable": "QIP_ALPACA_API_SECRET_KEY" }
  },
  "endpoint": {
    "path": "/v2/stocks/bars",
    "query": {
      "adjustment": "raw",
      "feed": "iex",
      "limit": "10",
      "sort": "asc",
      "symbols": "AAPL,MSFT",
      "timeframe": "1Day"
    },
    "health_path": "/v2/stocks/bars"
  },
  "rate_limit": { "requests": 100, "per_ms": 60000, "burst": 100 },
  "retry": {
    "max_attempts": 4,
    "initial_backoff_ms": 500,
    "max_backoff_ms": 30000,
    "multiplier": 3,
    "jitter_basis_points": 2500
  },
  "poll_interval_ms": 900000,
  "freshness_sla_ms": 345600000,
  "publication_delay_ms": 61200000,
  "licensing": "restricted",
  "max_events_per_batch": 20
}
