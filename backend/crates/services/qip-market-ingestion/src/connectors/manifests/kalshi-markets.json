{
  "source_id": "kalshi-markets",
  "provider": "Kalshi (api.elections.kalshi.com), a CFTC-regulated designated contract market; the public, unauthenticated list of open binary markets. A candidate under ADR 0034 whose terms have not been read: the class here is the fail-closed floor, and qip-data-finder's catalogue refuses the source until they are.",
  "asset_class": "alternative",
  "region": "north_america",
  "protocol": "poll",
  "schema": {
    "version": "1.0",
    "required_fields": [
      { "path": "markets", "kind": "array" }
    ],
    "unknown_fields": "ignore"
  },
  "auth": { "scheme": "none" },
  "endpoint": {
    "path": "/trade-api/v2/markets",
    "query": { "limit": "20", "mve_filter": "exclude", "status": "open" },
    "health_path": "/trade-api/v2/exchange/status"
  },
  "rate_limit": { "requests": 5, "per_ms": 1000, "burst": 10 },
  "retry": {
    "max_attempts": 4,
    "initial_backoff_ms": 500,
    "max_backoff_ms": 15000,
    "multiplier": 3,
    "jitter_basis_points": 2500
  },
  "poll_interval_ms": 10000,
  "freshness_sla_ms": 120000,
  "publication_delay_ms": 0,
  "licensing": "restricted",
  "max_events_per_batch": 20
}
