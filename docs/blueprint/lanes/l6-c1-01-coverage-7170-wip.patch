+// --- bounded history --------------------------------------------------------
+
+/// A brain superseded on every tuning pass would otherwise hold every spec it
+/// ever had for the life of the node.
+#[test]
+fn a_brains_superseded_versions_are_bounded_and_the_oldest_is_given_up_while_the_version_still_rises()
+ {
+    const ID: &str = "analyst/credit";
+    let mut registry = BrainRegistry::new();
+    registry.register(brain(1, None, "screen")).unwrap();
+    let last = u32::try_from(VERSIONS_PER_BRAIN).unwrap() + 2;
+    for version in 2..=last {
+        registry
+            .succeed(brain(version, Some(version_id(ID, version - 1)), "screen"))
+            .unwrap();
+    }
+    // Premise: more versions were superseded than the bound keeps.
+    assert_eq!(registry.latest_version(ID), Some(last));
+    assert!(usize::try_from(last - 1).unwrap() > VERSIONS_PER_BRAIN);
+
+    let held = (1..=last)
+        .filter(|version| registry.get_version(ID, *version).is_some())
+        .count();
+    assert_eq!(
+        held,
+        VERSIONS_PER_BRAIN + 1,
+        "the bound's superseded versions and the one in force"
+    );
+    assert!(registry.get_version(ID, 1).is_none(), "the oldest was kept");
+    assert!(registry.get_version(ID, last - 1).is_some());
+    // The number did not restart: the version given up stays refused.
+    assert!(registry.succeed(brain(1, None, "screen")).is_err());
+}
+
+/// A source re-assessed on every monitoring pass would otherwise hold every
+/// registration it ever had.
+#[test]
+fn a_sources_superseded_registrations_are_bounded_and_the_oldest_is_given_up_while_the_version_still_rises()
+ {
+    let mut finder = finder();
+    let mut probe = source_probe();
+    let last = u32::try_from(DataFinder::VERSIONS_PER_SOURCE).unwrap() + 2;
+    for version in 1..=last {
+        let at = now().saturating_add(Duration::from_hours(i64::from(version)));
+        let decision = finder
+            .assess(vec![source_candidate("bounded")], &mut probe, at)
+            .unwrap();
+        assert!(decision[0].is_registered(), "{:?}", decision[0].outcome());
+    }
+    // Premise: more registrations were superseded than the bound keeps.
+    assert_eq!(
+        finder.registered("bounded").map(|r| r.version()),
+        Some(last)
+    );
+
+    let held = (1..=last)
+        .filter(|version| finder.registered_version("bounded", *version).is_some())
+        .count();
+    assert_eq!(
+        held,
+        DataFinder::VERSIONS_PER_SOURCE + 1,
+        "the bound's superseded registrations and the one in force"
+    );
+    assert!(
+        finder.registered_version("bounded", 1).is_none(),
+        "the oldest was kept"
+    );
+    assert!(finder.registered_version("bounded", last - 1).is_some());
+}
