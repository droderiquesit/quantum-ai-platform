+fn capability(implementation: &str) -> CapabilityEntry {
+    CapabilityEntry {
+        verb: CapabilityVerb::Simulate,
+        implementations: vec![implementation.to_string()],
+        confidence_level: 0.8,
+        eligibility: "paper only".to_string(),
+    }
+}
