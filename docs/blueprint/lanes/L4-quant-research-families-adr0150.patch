+// --------------------------------------------------------------------------
+// Feature / ensemble selection (R12-QUANT-1078, -4035, -4059)
+// --------------------------------------------------------------------------
+
+/// Rows of features and the target they predict.
+#[derive(Clone, Debug, PartialEq, Serialize)]
+pub struct Dataset {
+    /// One row per observation, one column per candidate feature.
+    pub rows: Vec<Vec<f64>>,
+    pub target: Vec<f64>,
+}
+
+impl Dataset {
+    fn columns(&self) -> usize {
+        self.rows.first().map_or(0, Vec::len)
+    }
+
+    fn validate(&self, name: &str, columns: usize) -> Result<()> {
+        if self.rows.is_empty() || self.rows.len() != self.target.len() {
+            return Err(Error::invalid(format!(
+                "the {name} set holds {} row(s) and {} target(s); it needs at least one row and \
+                 one target per row",
+                self.rows.len(),
+                self.target.len()
+            )));
+        }
+        for row in &self.rows {
+            if row.len() != columns {
+                return Err(Error::invalid(format!(
+                    "a {name} row holds {} feature(s) where {columns} were declared",
+                    row.len()
+                )));
+            }
+            if row.iter().any(|v| !v.is_finite()) {
+                return Err(Error::invalid(format!(
+                    "a {name} row holds a non-finite value"
+                )));
+            }
+        }
+        if self.target.iter().any(|v| !v.is_finite()) {
+            return Err(Error::invalid(format!(
+                "the {name} target holds a non-finite value"
+            )));
+        }
+        Ok(())
+    }
+
+    fn column(&self, j: usize) -> Vec<f64> {
+        self.rows.iter().map(|r| r[j]).collect()
+    }
+}
+
+/// Choose exactly `select` of the candidate features for a compact learner.
+#[derive(Clone, Debug, PartialEq, Serialize)]
+pub struct FeatureSelection {
+    pub train: Dataset,
+    /// Scored only after selection; never read by the encoding or the
+    /// baseline, so a selection cannot be fitted to it.
+    pub held_out: Dataset,
+    pub select: usize,
+    /// How much a pair's redundancy costs against their joint relevance.
+    pub redundancy_weight: f64,
+    /// Ridge penalty of the learner the selection is scored with.
+    pub ridge: f64,
+}
+
+/// |Pearson correlation|, zero for a constant series. A statistic, so `f64`.
+fn abs_correlation(a: &[f64], b: &[f64]) -> f64 {
+    let n = a.len() as f64;
+    let (ma, mb) = (a.iter().sum::<f64>() / n, b.iter().sum::<f64>() / n);
+    let (mut sab, mut saa, mut sbb) = (0.0, 0.0, 0.0);
+    for (x, y) in a.iter().zip(b) {
+        sab += (x - ma) * (y - mb);
+        saa += (x - ma) * (x - ma);
+        sbb += (y - mb) * (y - mb);
+    }
+    if saa <= 0.0 || sbb <= 0.0 {
+        0.0
+    } else {
+        (sab / (saa * sbb).sqrt()).abs()
+    }
+}
+
+/// Fit ridge regression with an unpenalised intercept on `columns` of
+/// `train`, and return the fitted coefficients (intercept first).
+fn fit_ridge(train: &Dataset, columns: &[usize], ridge: f64) -> Result<Vec<f64>> {
+    let p = columns.len() + 1;
+    let mut gram = Matrix::zeros(p, p);
+    let mut rhs = vec![0.0; p];
+    for (row, y) in train.rows.iter().zip(&train.target) {
+        let x: Vec<f64> = std::iter::once(1.0)
+            .chain(columns.iter().map(|&j| row[j]))
+            .collect();
+        for a in 0..p {
+            rhs[a] += x[a] * y;
+            for b in 0..p {
+                gram.add_to(a, b, x[a] * x[b]);
+            }
+        }
+    }
+    for a in 1..p {
+        gram.add_to(a, a, ridge);
+    }
+    gram.solve(&rhs)
+}
+
+fn mean_squared_error(data: &Dataset, columns: &[usize], beta: &[f64]) -> f64 {
+    let total: f64 = data
+        .rows
+        .iter()
+        .zip(&data.target)
+        .map(|(row, y)| {
+            let fitted = beta[0]
+                + columns
+                    .iter()
+                    .zip(&beta[1..])
+                    .map(|(&j, b)| row[j] * b)
+                    .sum::<f64>();
+            (y - fitted) * (y - fitted)
+        })
+        .sum();
+    total / data.rows.len() as f64
+}
+
+impl FeatureSelection {
+    /// The largest candidate set the in-tree statevector is asked to carry.
+    pub const MAX_CANDIDATES: usize = 12;
+
+    pub fn validate(&self) -> Result<()> {
+        let columns = self.train.columns();
+        if columns == 0 || columns > Self::MAX_CANDIDATES {
+            return Err(Error::invalid(format!(
+                "feature selection takes 1 to {} candidate features, got {columns}",
+                Self::MAX_CANDIDATES
+            )));
+        }
+        self.train.validate("training", columns)?;
+        self.held_out.validate("held-out", columns)?;
+        if self.select == 0 || self.select > columns {
+            return Err(Error::invalid(format!(
+                "select names how many of the {columns} features to keep, 1 to {columns}; got {}",
+                self.select
+            )));
+        }
+        if self.train.rows.len() <= self.select + 1 {
+            return Err(Error::invalid(
+                "the training set must hold more rows than the selected learner has coefficients",
+            ));
+        }
+        finite("the redundancy weight", self.redundancy_weight)?;
+        if self.redundancy_weight < 0.0 {
+            return Err(Error::invalid(
+                "a negative redundancy weight would reward duplicated features; pass zero or more",
+            ));
+        }
+        finite("the ridge penalty", self.ridge)?;
+        if self.ridge <= 0.0 {
+            return Err(Error::invalid("the ridge penalty must be positive"));
+        }
+        Ok(())
+    }
+
+    fn relevance(&self) -> Vec<f64> {
+        (0..self.train.columns())
+            .map(|j| abs_correlation(&self.train.column(j), &self.train.target))
+            .collect()
+    }
+
+    fn redundancy(&self, i: usize, j: usize) -> f64 {
+        abs_correlation(&self.train.column(i), &self.train.column(j))
+    }
+
+    /// Minimise `-sum r_i x_i + w sum_{i<j} R_ij x_i x_j + P (sum x - k)^2`:
+    /// relevance to the target, redundancy between the kept pair, and a
+    /// cardinality penalty larger than any swing the first two can make.
+    pub fn to_qubo(&self) -> Result<Qubo> {
+        self.validate()?;
+        let n = self.train.columns();
+        let relevance = self.relevance();
+        let mut qubo = Qubo::new(n);
+        let mut swing: f64 = relevance.iter().sum();
+        for (i, r) in relevance.iter().enumerate() {
+            qubo.add_linear(i, -r);
+            for j in (i + 1)..n {
+                let cost = self.redundancy_weight * self.redundancy(i, j);
+                swing += cost;
+                qubo.add(i, j, cost);
+            }
+        }
+        let terms: Vec<(usize, f64)> = (0..n).map(|i| (i, 1.0)).collect();
+        add_squared_equality(&mut qubo, &terms, self.select as f64, 1.0 + swing);
+        Ok(qubo)
+    }
+
+    /// The selection an assignment encodes and its held-out loss; refused
+    /// unless it keeps exactly `select` features.
+    pub fn decode(&self, assignment: &[u8]) -> Result<(Vec<usize>, f64)> {
+        let n = self.train.columns();
+        if assignment.len() != n {
+            return Err(Error::invalid(format!(
+                "a {n}-feature selection is {n} bits, got {}",
+                assignment.len()
+            )));
+        }
+        let members: Vec<usize> = (0..n).filter(|&i| assignment[i] == 1).collect();
+        if members.len() != self.select {
+            return Err(Error::invalid(format!(
+                "the selection keeps {} feature(s) where exactly {} were asked for",
+                members.len(),
+                self.select
+            )));
+        }
+        let loss = self.held_out_loss(&members)?;
+        Ok((members, loss))
+    }
+
+    /// Mean squared error on the held-out set of a ridge learner fitted on
+    /// the training set over `members`.
+    pub fn held_out_loss(&self, members: &[usize]) -> Result<f64> {
+        let beta = fit_ridge(&self.train, members, self.ridge)?;
+        let loss = mean_squared_error(&self.held_out, members, &beta);
+        finite("the held-out loss", loss)?;
+        Ok(loss)
+    }
+
+    /// Classical baseline: forward selection by relevance less redundancy
+    /// with what is already kept (minimum-redundancy, maximum-relevance).
+    pub fn greedy_forward(&self) -> Result<Vec<usize>> {
+        self.validate()?;
+        let relevance = self.relevance();
+        let mut kept: Vec<usize> = Vec::new();
+        while kept.len() < self.select {
+            let next = (0..relevance.len())
+                .filter(|i| !kept.contains(i))
+                .map(|i| {
+                    let penalty: f64 = kept
+                        .iter()
+                        .map(|&j| self.redundancy_weight * self.redundancy(i, j))
+                        .sum();
+                    (i, relevance[i] - penalty)
+                })
+                .max_by(|a, b| a.1.partial_cmp(&b.1).unwrap_or(std::cmp::Ordering::Equal))
+                .map(|(i, _)| i)
+                .ok_or_else(|| Error::invalid("no feature is left to select"))?;
+            kept.push(next);
+        }
+        kept.sort_unstable();
+        Ok(kept)
+    }
+
+    /// Run the family: greedy baseline, then the QUBO through `benchmark`
+    /// (whose own classical solve is recorded beside every entrant), every
+    /// answer scored on held-out loss.
+    pub fn run_experiment(&self, benchmark: &SolverBenchmark) -> Result<FamilyExperiment> {
+        let qubo = self.to_qubo()?;
+        let greedy = self.greedy_forward()?;
+        let baseline = BaselineOutcome {
+            selector: FEATURE_SELECTION_BASELINE.to_string(),
+            score: self.held_out_loss(&greedy)?,
+            members: greedy,
+        };
+        let report = benchmark.run(&qubo)?;
+        FamilyExperiment::new(
+            FamilyKind::FeatureEnsembleSelection,
+            FEATURE_SELECTION_ENCODING,
+            FEATURE_SELECTION_BASELINE,
+            digest_of(self)?,
+            false,
+            "held-out mean squared error of a ridge learner on the selection",
+            qubo.n,
+            baseline,
+            decoded_entrants(&report, |bits| self.decode(bits)),
+            simulation_note(&report),
+        )
+    }
+}
+
+// --------------------------------------------------------------------------
+// Scenario / hypothesis selection under a compute budget (R12-QUANT-1081,
+// -4038, -4041)
+// --------------------------------------------------------------------------
+
+/// One scenario or experiment a desk could run.
+#[derive(Clone, Debug, PartialEq, Serialize)]
+pub struct Scenario {
+    pub id: String,
+    /// Expected information the run yields. Positive.
+    pub information: f64,
+    /// Compute units the run costs. Positive.
+    pub cost: u32,
+    /// The hypothesis the scenario tests.
+    pub hypothesis: String,
+    /// Whether the hypothesis is a minority explanation the selection must
+    /// keep alive.
+    pub minority: bool,
+}
+
+/// Choose scenarios that maximise information less overlap inside a budget,
+/// keeping at least one minority hypothesis where any is offered.
+#[derive(Clone, Debug, PartialEq, Serialize)]
+pub struct ScenarioSelection {
+    pub scenarios: Vec<Scenario>,
+    /// Symmetric, `[0, 1]`, how much two scenarios tell you the same thing.
+    pub similarity: Vec<Vec<f64>>,
+    pub budget: u32,
+    pub overlap_weight: f64,
+}
+
+impl ScenarioSelection {
+    /// Above this many scenarios plus slack bits the statevector is not asked.
+    pub const MAX_VARIABLES: usize = 16;
+
+    fn minority_indices(&self) -> Vec<usize> {
+        (0..self.scenarios.len())
+            .filter(|&i| self.scenarios[i].minority)
+            .collect()
+    }
+
+    fn budget_slack(&self) -> usize {
+        slack_bits(self.budget)
+    }
+
+    fn minority_slack(&self) -> usize {
+        let m = self.minority_indices().len();
+        if m == 0 {
+            0
+        } else {
+            slack_bits(u32::try_from(m - 1).unwrap_or(u32::MAX))
+        }
+    }
+
+    pub fn validate(&self) -> Result<()> {
+        let n = self.scenarios.len();
+        if n == 0 {
+            return Err(Error::invalid(
+                "a scenario selection needs scenarios to choose from",
+            ));
+        }
+        let mut ids = BTreeSet::new();
+        for s in &self.scenarios {
+            if s.id.trim().is_empty() || !ids.insert(s.id.trim()) {
+                return Err(Error::invalid(format!(
+                    "every scenario needs a distinct, non-blank id; {:?} is not",
+                    s.id
+                )));
+            }
+            if s.hypothesis.trim().is_empty() {
+                return Err(Error::invalid(format!(
+                    "scenario {} names no hypothesis it tests",
+                    s.id
+                )));
+            }
+            if !s.information.is_finite() || s.information <= 0.0 {
+                return Err(Error::invalid(format!(
+                    "scenario {} must offer positive, finite information",
+                    s.id
+                )));
+            }
+            if s.cost == 0 {
+                return Err(Error::invalid(format!(
+                    "scenario {} costs nothing; a free run needs no budget to choose it",
+                    s.id
+                )));
+            }
+        }
+        if self.budget == 0 {
+            return Err(Error::invalid("a zero budget admits no scenario"));
+        }
+        if self.similarity.len() != n || self.similarity.iter().any(|r| r.len() != n) {
+            return Err(Error::invalid(format!(
+                "the similarity matrix must be {n} by {n}"
+            )));
+        }
+        for i in 0..n {
+            for j in 0..n {
+                let s = self.similarity[i][j];
+                if !(0.0..=1.0).contains(&s) || (s - self.similarity[j][i]).abs() > 1e-12 {
+                    return Err(Error::invalid(
+                        "similarity is symmetric and in [0, 1]; refusing rather than clamping",
+                    ));
+                }
+            }
+        }
+        finite("the overlap weight", self.overlap_weight)?;
+        if self.overlap_weight < 0.0 {
+            return Err(Error::invalid(
+                "a negative overlap weight would reward running the same experiment twice",
+            ));
+        }
+        let variables = n + self.budget_slack() + self.minority_slack();
+        if variables > Self::MAX_VARIABLES {
+            return Err(Error::invalid(format!(
+                "{variables} QUBO variables exceed the {} this family carries",
+                Self::MAX_VARIABLES
+            )));
+        }
+        Ok(())
+    }
+
+    /// Information less overlap, the family's measure. Higher is better.
+    pub fn value(&self, members: &[usize]) -> f64 {
+        let info: f64 = members.iter().map(|&i| self.scenarios[i].information).sum();
+        let mut overlap = 0.0;
+        for (k, &i) in members.iter().enumerate() {
+            for &j in &members[k + 1..] {
+                overlap += self.similarity[i][j];
+            }
+        }
+        info - self.overlap_weight * overlap
+    }
+
+    /// Refuse a selection over budget, or one that drops every minority
+    /// hypothesis while one was offered (R12-QUANT-4041).
+    pub fn check(&self, members: &[usize]) -> Result<()> {
+        let cost: u64 = members
+            .iter()
+            .map(|&i| u64::from(self.scenarios[i].cost))
+            .sum();
+        if cost > u64::from(self.budget) {
+            return Err(Error::denied(format!(
+                "the selection costs {cost} against a budget of {}",
+                self.budget
+            )));
+        }
+        let minority = self.minority_indices();
+        if !minority.is_empty() && !members.iter().any(|i| minority.contains(i)) {
+            return Err(Error::denied(
+                "the selection drops every minority hypothesis; at least one must stay under \
+                 test, or a budget becomes a way to settle a question without asking it",
+            ));
+        }
+        Ok(())
+    }
+
+    /// Maximise value as `-value`, with two equalities as penalties:
+    /// `sum c_i x_i + sum 2^j s_j = B` (the budget, slack absorbing what is
+    /// left) and, where minorities exist, `sum_m x_m - sum 2^j t_j = 1` (at
+    /// least one kept, slack absorbing the rest).
+    pub fn to_qubo(&self) -> Result<Qubo> {
+        self.validate()?;
+        let n = self.scenarios.len();
+        let budget_bits = self.budget_slack();
+        let minority_bits = self.minority_slack();
+        let mut qubo = Qubo::new(n + budget_bits + minority_bits);
+        let mut swing = 0.0;
+        for i in 0..n {
+            qubo.add_linear(i, -self.scenarios[i].information);
+            swing += self.scenarios[i].information;
+            for j in (i + 1)..n {
+                let cost = self.overlap_weight * self.similarity[i][j];
+                swing += cost;
+                qubo.add(i, j, cost);
+            }
+        }
+        let penalty = 1.0 + swing;
+        let mut budget: Vec<(usize, f64)> = (0..n)
+            .map(|i| (i, f64::from(self.scenarios[i].cost)))
+            .collect();
+        budget.extend((0..budget_bits).map(|b| (n + b, f64::from(1u32 << b))));
+        add_squared_equality(&mut qubo, &budget, f64::from(self.budget), penalty);
+        let minority = self.minority_indices();
+        if !minority.is_empty() {
+            let mut keep: Vec<(usize, f64)> = minority.iter().map(|&i| (i, 1.0)).collect();
+            keep.extend((0..minority_bits).map(|b| (n + budget_bits + b, -f64::from(1u32 << b))));
+            add_squared_equality(&mut qubo, &keep, 1.0, penalty);
+        }
+        Ok(qubo)
+    }
+
+    pub fn decode(&self, assignment: &[u8]) -> Result<(Vec<usize>, f64)> {
+        let n = self.scenarios.len();
+        let expected = n + self.budget_slack() + self.minority_slack();
+        if assignment.len() != expected {
+            return Err(Error::invalid(format!(
+                "this selection is {expected} bits, got {}",
+                assignment.len()
+            )));
+        }
+        let members: Vec<usize> = (0..n).filter(|&i| assignment[i] == 1).collect();
+        self.check(&members)?;
+        Ok((members.clone(), self.value(&members)))
+    }
+
+    /// Classical baseline: seed with the best minority scenario by
+    /// information per unit cost where any is offered, then add by
+    /// marginal value per unit cost while the budget allows.
+    pub fn greedy_by_value_per_cost(&self) -> Result<Vec<usize>> {
+        self.validate()?;
+        let n = self.scenarios.len();
+        let mut kept: Vec<usize> = Vec::new();
+        let mut spent: u64 = 0;
+        let ratio = |i: usize, kept: &[usize]| {
+            let mut with = kept.to_vec();
+            with.push(i);
+            (self.value(&with) - self.value(kept)) / f64::from(self.scenarios[i].cost)
+        };
+        let minority = self.minority_indices();
+        if !minority.is_empty() {
+            let seed = minority
+                .iter()
+                .copied()
+                .filter(|&i| u64::from(self.scenarios[i].cost) <= u64::from(self.budget))
+                .max_by(|&a, &b| {
+                    ratio(a, &[])
+                        .partial_cmp(&ratio(b, &[]))
+                        .unwrap_or(std::cmp::Ordering::Equal)
+                })
+                .ok_or_else(|| {
+                    Error::denied(
+                        "no minority scenario fits the budget, so no admissible selection exists",
+                    )
+                })?;
+            spent += u64::from(self.scenarios[seed].cost);
+            kept.push(seed);
+        }
+        loop {
+            let next = (0..n)
+                .filter(|i| !kept.contains(i))
+                .filter(|&i| spent + u64::from(self.scenarios[i].cost) <= u64::from(self.budget))
+                .map(|i| (i, ratio(i, &kept)))
+                .filter(|(_, r)| *r > 0.0)
+                .max_by(|a, b| a.1.partial_cmp(&b.1).unwrap_or(std::cmp::Ordering::Equal));
+            match next {
+                Some((i, _)) => {
+                    spent += u64::from(self.scenarios[i].cost);
+                    kept.push(i);
+                }
+                None => break,
+            }
+        }
+        kept.sort_unstable();
+        self.check(&kept)?;
+        Ok(kept)
+    }
+
+    pub fn run_experiment(&self, benchmark: &SolverBenchmark) -> Result<FamilyExperiment> {
+        let qubo = self.to_qubo()?;
+        let greedy = self.greedy_by_value_per_cost()?;
+        let baseline = BaselineOutcome {
+            selector: SCENARIO_SELECTION_BASELINE.to_string(),
+            score: self.value(&greedy),
+            members: greedy,
+        };
+        let report = benchmark.run(&qubo)?;
+        FamilyExperiment::new(
+            FamilyKind::ScenarioHypothesisSelection,
+            SCENARIO_SELECTION_ENCODING,
+            SCENARIO_SELECTION_BASELINE,
+            digest_of(self)?,
+            true,
+            "information less overlap of the selected scenarios, inside the budget",
+            qubo.n,
+            baseline,
+            decoded_entrants(&report, |bits| self.decode(bits)),
+            simulation_note(&report),
+        )
+    }
+}
+
+// --------------------------------------------------------------------------
+// Graph search: a maximum-weight conflict-free set (R12-QUANT-1077, -4033)
+// --------------------------------------------------------------------------
+
+/// A candidate (a multi-leg cycle, a route) with its value and the
+/// resources it holds while it runs.
+#[derive(Clone, Debug, PartialEq, Serialize)]
+pub struct GraphCandidate {
+    pub id: String,
+    /// What selecting it is worth. Positive.
+    pub weight: f64,
+    /// Inventory, a settlement slot, a venue's concurrency: two candidates
+    /// holding one resource conflict.
+    pub resources: BTreeSet<String>,
+}
+
+/// Choose the heaviest set of candidates no two of which share a resource:
+/// a maximum-weight independent set on the conflict graph.
+#[derive(Clone, Debug, PartialEq, Serialize)]
+pub struct ConflictGraph {
+    pub candidates: Vec<GraphCandidate>,
+}
+
+impl ConflictGraph {
+    pub const MAX_CANDIDATES: usize = 16;
+
+    pub fn validate(&self) -> Result<()> {
+        let n = self.candidates.len();
+        if n == 0 || n > Self::MAX_CANDIDATES {
+            return Err(Error::invalid(format!(
+                "graph search takes 1 to {} candidates, got {n}",
+                Self::MAX_CANDIDATES
+            )));
+        }
+        let mut ids = BTreeSet::new();
+        for c in &self.candidates {
+            if c.id.trim().is_empty() || !ids.insert(c.id.trim()) {
+                return Err(Error::invalid(format!(
+                    "every candidate needs a distinct, non-blank id; {:?} is not",
+                    c.id
+                )));
+            }
+            if !c.weight.is_finite() || c.weight <= 0.0 {
+                return Err(Error::invalid(format!(
+                    "candidate {} must be worth a positive, finite amount",
+                    c.id
+                )));
+            }
+            if c.resources.is_empty() {
+                return Err(Error::invalid(format!(
+                    "candidate {} holds no resource; a candidate that holds nothing cannot be \
+                     checked for conflicts",
+                    c.id
+                )));
+            }
+        }
+        Ok(())
+    }
+
+    /// The conflict edges, `i < j`.
+    pub fn conflicts(&self) -> Vec<(usize, usize)> {
+        let n = self.candidates.len();
+        let mut out = Vec::new();
+        for i in 0..n {
+            for j in (i + 1)..n {
+                if !self.candidates[i]
+                    .resources
+                    .is_disjoint(&self.candidates[j].resources)
+                {
+                    out.push((i, j));
+                }
+            }
+        }
+        out
+    }
+
+    pub fn weight(&self, members: &[usize]) -> f64 {
+        members.iter().map(|&i| self.candidates[i].weight).sum()
+    }
+
+    /// Minimise `-sum w_i x_i + P sum_{(i,j) in E} x_i x_j`, with `P` above
+    /// the heaviest candidate so dropping one of a conflicting pair always
+    /// pays.
+    pub fn to_qubo(&self) -> Result<Qubo> {
+        self.validate()?;
+        let n = self.candidates.len();
+        let heaviest = self.candidates.iter().map(|c| c.weight).fold(0.0, f64::max);
+        let mut qubo = Qubo::new(n);
+        for (i, c) in self.candidates.iter().enumerate() {
+            qubo.add_linear(i, -c.weight);
+        }
+        for (i, j) in self.conflicts() {
+            qubo.add(i, j, 1.0 + 2.0 * heaviest);
+        }
+        Ok(qubo)
+    }
+
+    pub fn decode(&self, assignment: &[u8]) -> Result<(Vec<usize>, f64)> {
+        let n = self.candidates.len();
+        if assignment.len() != n {
+            return Err(Error::invalid(format!(
+                "a {n}-candidate selection is {n} bits, got {}",
+                assignment.len()
+            )));
+        }
+        let members: Vec<usize> = (0..n).filter(|&i| assignment[i] == 1).collect();
+        for (i, j) in self.conflicts() {
+            if members.contains(&i) && members.contains(&j) {
+                return Err(Error::denied(format!(
+                    "candidates {} and {} share a resource and cannot both run",
+                    self.candidates[i].id, self.candidates[j].id
+                )));
+            }
+        }
+        Ok((members.clone(), self.weight(&members)))
+    }
+
+    /// Classical baseline: heaviest first, skipping any that conflicts with
+    /// one already kept.
+    pub fn greedy_by_weight(&self) -> Result<Vec<usize>> {
+        self.validate()?;
+        let mut order: Vec<usize> = (0..self.candidates.len()).collect();
+        order.sort_by(|&a, &b| {
+            self.candidates[b]
+                .weight
+                .partial_cmp(&self.candidates[a].weight)
+                .unwrap_or(std::cmp::Ordering::Equal)
+        });
+        let mut kept: Vec<usize> = Vec::new();
+        for i in order {
+            if kept.iter().all(|&j| {
+                self.candidates[i]
+                    .resources
+                    .is_disjoint(&self.candidates[j].resources)
+            }) {
+                kept.push(i);
+            }
+        }
+        kept.sort_unstable();
+        Ok(kept)
+    }
+
+    pub fn run_experiment(&self, benchmark: &SolverBenchmark) -> Result<FamilyExperiment> {
+        let qubo = self.to_qubo()?;
+        let greedy = self.greedy_by_weight()?;
+        let baseline = BaselineOutcome {
+            selector: GRAPH_SEARCH_BASELINE.to_string(),
+            score: self.weight(&greedy),
+            members: greedy,
+        };
+        let report = benchmark.run(&qubo)?;
+        FamilyExperiment::new(
+            FamilyKind::GraphSearch,
+            GRAPH_SEARCH_ENCODING,
+            GRAPH_SEARCH_BASELINE,
+            digest_of(self)?,
+            true,
+            "total weight of a conflict-free selection",
+            qubo.n,
+            baseline,
+            decoded_entrants(&report, |bits| self.decode(bits)),
+            simulation_note(&report),
+        )
+    }
+}
