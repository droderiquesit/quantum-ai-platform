+//! The Quantum Foundry's combinatorial research families (R12-QUANT-1077,
+//! -1078, -1081, -4035, -4038, -4041).
+//!
+//! Each family is three things the foundry refuses to register without: an
+//! encoding that turns the family's problem into a QUBO, a classical
+//! baseline that solves the *problem* rather than the QUBO, and a benchmark
+//! that runs both and scores every answer on the problem's own measure. The
+//! last part is the one that matters. A QUBO's energy is a penalty landscape
+//! somebody chose; a feature subset is good when a model fitted on it
+//! predicts held-out data, and a scenario set is good when it buys
+//! information inside the budget. So every QUBO answer -- the exhaustive
+//! classical solver's and any quantum entrant's -- is decoded, refused if it
+//! breaks a constraint, and re-scored on that measure beside the greedy
+//! baseline. A quantum answer that wins on energy and loses on held-out loss
+//! has lost, and the record says so.
+//!
+//! The experiment record ([`FamilyExperiment`]) is constructed only by the
+//! family runners here and validates itself on construction: a record that
+//! names no problem digest, no baseline score or an entrant with neither a
+//! score nor a refusal is not one this type can hold.
+//!
+//! Everything here runs on the in-tree statevector through
+//! [`crate::provider::SimulatedProvider`] in tests. A simulator answer
+//! validates a formulation; it is not evidence of quantum advantage (ADR
+//! 0006), and the record's `simulated` note says so.
+
+use crate::benchmark::{BenchmarkReport, SolverBenchmark};
+use crate::foundry::FamilyKind;
+use crate::solver::SolverKind;
+use qip_core::Decimal;
+use qip_core::error::{Error, Result};
+use qip_core::time::Duration;
+use qip_numerics::anneal::Qubo;
+use qip_numerics::matrix::Matrix;
+use serde::Serialize;
+use std::collections::BTreeSet;
+
+/// The encoder [`crate::foundry::Foundry::platform`] declares for feature
+/// and ensemble selection.
+pub const FEATURE_SELECTION_ENCODING: &str = "FeatureSelection::to_qubo";
+/// The classical selector the feature family is benchmarked against.
+pub const FEATURE_SELECTION_BASELINE: &str = "FeatureSelection::greedy_forward";
+/// The encoder declared for scenario and hypothesis selection.
+pub const SCENARIO_SELECTION_ENCODING: &str = "ScenarioSelection::to_qubo";
+/// The classical selector the scenario family is benchmarked against.
+pub const SCENARIO_SELECTION_BASELINE: &str = "ScenarioSelection::greedy_by_value_per_cost";
+/// The encoder declared for graph search.
+pub const GRAPH_SEARCH_ENCODING: &str = "ConflictGraph::to_qubo";
+/// The classical search the graph family is benchmarked against.
+pub const GRAPH_SEARCH_BASELINE: &str = "ConflictGraph::greedy_by_weight";
+/// The benchmark every combinatorial family is run through.
+pub const COMBINATORIAL_BENCHMARK: &str =
+    "families::FamilyExperiment (SolverBenchmark::run, decoded and re-scored on the problem)";
+
+/// One solver's answer, decoded and scored on the family's own measure.
+#[derive(Clone, Debug, PartialEq, Serialize)]
+pub struct EntrantOutcome {
+    pub solver: String,
+    pub kind: SolverKind,
+    /// The decoded selection, in index order, when the answer was usable.
+    pub members: Option<Vec<usize>>,
+    /// The family's measure of the selection. `None` exactly when refused.
+    pub score: Option<f64>,
+    /// Why the answer could not be used, when it could not.
+    pub refusal: Option<String>,
+    /// Modelled, as the benchmark models it.
+    pub runtime: Duration,
+    /// Exact money, never an `f64`.
+    pub price: Decimal,
+}
+
+/// The classical baseline's selection and its score.
+#[derive(Clone, Debug, PartialEq, Serialize)]
+pub struct BaselineOutcome {
+    pub selector: String,
+    pub members: Vec<usize>,
+    pub score: f64,
+}
+
+/// A QuantumExperiment / Benchmark record for one run of one family.
+///
+/// Private fields and one constructor: only a family runner in this module
+/// builds one, and it validates itself before it exists.
+#[derive(Clone, Debug, PartialEq, Serialize)]
+pub struct FamilyExperiment {
+    family: FamilyKind,
+    encoding: String,
+    classical_baseline: String,
+    /// SHA-256 of the canonical problem: the lineage a reader re-derives the
+    /// experiment from.
+    problem_digest: String,
+    /// The measure's direction. Held-out loss is lower-is-better; information
+    /// and edge are higher-is-better.
+    higher_is_better: bool,
+    measure: String,
+    variables: usize,
+    baseline: BaselineOutcome,
+    entrants: Vec<EntrantOutcome>,
+    notes: Vec<String>,
+}
+
+impl FamilyExperiment {
+    #[allow(clippy::too_many_arguments)]
+    fn new(
+        family: FamilyKind,
+        encoding: &str,
+        classical_baseline: &str,
+        problem_digest: String,
+        higher_is_better: bool,
+        measure: &str,
+        variables: usize,
+        baseline: BaselineOutcome,
+        entrants: Vec<EntrantOutcome>,
+        notes: Vec<String>,
+    ) -> Result<Self> {
+        let experiment = Self {
+            family,
+            encoding: encoding.to_string(),
+            classical_baseline: classical_baseline.to_string(),
+            problem_digest,
+            higher_is_better,
+            measure: measure.to_string(),
+            variables,
+            baseline,
+            entrants,
+            notes,
+        };
+        experiment.validate()?;
+        Ok(experiment)
+    }
+
+    /// Refuse a record nobody could re-derive or read.
+    pub fn validate(&self) -> Result<()> {
+        if self.problem_digest.len() != 64
+            || !self.problem_digest.bytes().all(|b| b.is_ascii_hexdigit())
+        {
+            return Err(Error::invalid(
+                "a quantum experiment carries the SHA-256 of the problem it ran; without it the \
+                 result has no lineage",
+            ));
+        }
+        if self.encoding.trim().is_empty() || self.classical_baseline.trim().is_empty() {
+            return Err(Error::invalid(
+                "a quantum experiment names its encoding and its classical baseline",
+            ));
+        }
+        if !self.baseline.score.is_finite() {
+            return Err(Error::numeric(
+                "a quantum experiment's classical baseline has no finite score, so nothing is \
+                 measured against it",
+            ));
+        }
+        if self.entrants.is_empty() {
+            return Err(Error::invalid(
+                "a quantum experiment records at least the QUBO's classical solve",
+            ));
+        }
+        for entrant in &self.entrants {
+            match (&entrant.score, &entrant.refusal) {
+                (Some(score), None) if score.is_finite() => {}
+                (None, Some(reason)) if !reason.trim().is_empty() => {}
+                _ => {
+                    return Err(Error::invalid(format!(
+                        "entrant {} holds neither a finite score nor a stated refusal",
+                        entrant.solver
+                    )));
+                }
+            }
+        }
+        Ok(())
+    }
+
+    pub const fn family(&self) -> FamilyKind {
+        self.family
+    }
+    pub fn encoding(&self) -> &str {
+        &self.encoding
+    }
+    pub fn classical_baseline(&self) -> &str {
+        &self.classical_baseline
+    }
+    pub fn problem_digest(&self) -> &str {
+        &self.problem_digest
+    }
+    pub fn measure(&self) -> &str {
+        &self.measure
+    }
+    pub const fn variables(&self) -> usize {
+        self.variables
+    }
+    pub fn baseline(&self) -> &BaselineOutcome {
+        &self.baseline
+    }
+    pub fn entrants(&self) -> &[EntrantOutcome] {
+        &self.entrants
+    }
+    pub fn notes(&self) -> &[String] {
+        &self.notes
+    }
+
+    /// Signed improvement of an entrant over the classical baseline on the
+    /// family's measure: positive is better, whichever way the measure runs.
+    pub fn uplift_of(&self, entrant: &EntrantOutcome) -> Option<f64> {
+        let score = entrant.score?;
+        Some(if self.higher_is_better {
+            score - self.baseline.score
+        } else {
+            self.baseline.score - score
+        })
+    }
+
+    /// The best quantum entrant's uplift over the classical baseline, or
+    /// `None` when no quantum entrant produced a usable answer.
+    pub fn quantum_uplift(&self) -> Option<f64> {
+        self.entrants
+            .iter()
+            .filter(|e| e.kind == SolverKind::Quantum)
+            .filter_map(|e| self.uplift_of(e))
+            .fold(None, |best: Option<f64>, u| {
+                Some(best.map_or(u, |b| b.max(u)))
+            })
+    }
+}
+
+fn digest_of<T: Serialize>(problem: &T) -> Result<String> {
+    let bytes = serde_json::to_vec(problem)
+        .map_err(|e| Error::invalid(format!("the problem does not serialise: {e}")))?;
+    Ok(qip_core::hash::sha256_hex(&bytes))
+}
+
+fn finite(name: &str, value: f64) -> Result<()> {
+    if value.is_finite() {
+        Ok(())
+    } else {
+        Err(Error::invalid(format!(
+            "{name} must be finite, got {value}"
+        )))
+    }
+}
+
+/// Add `penalty * (sum_v a_v z_v - target)^2` to `qubo`, over `(index, a_v)`.
+///
+/// The square expands, with `z^2 = z`, to `a_v^2 - 2 target a_v` on each
+/// linear term, `2 a_u a_v` on each pair and `target^2` as offset.
+fn add_squared_equality(qubo: &mut Qubo, terms: &[(usize, f64)], target: f64, penalty: f64) {
+    for (k, &(u, a)) in terms.iter().enumerate() {
+        qubo.add_linear(u, penalty * (a * a - 2.0 * target * a));
+        for &(v, b) in &terms[k + 1..] {
+            qubo.add(u, v, penalty * 2.0 * a * b);
+        }
+    }
+    qubo.offset += penalty * target * target;
+}
+
+/// Binary slack bits whose weighted sum reaches every integer in `0..=max`.
+fn slack_bits(max: u32) -> usize {
+    (u32::BITS - max.leading_zeros()) as usize
+}
+
+/// Run the QUBO benchmark and decode every answer through `decode`, which
+/// either returns the selection and its score or refuses it.
+fn decoded_entrants<F>(report: &BenchmarkReport, decode: F) -> Vec<EntrantOutcome>
+where
+    F: Fn(&[u8]) -> Result<(Vec<usize>, f64)>,
+{
+    report
+        .records()
+        .map(|record| {
+            let (members, score, refusal) = match record.usable_solution() {
+                None => (
+                    None,
+                    None,
+                    Some(
+                        record
+                            .refusal
+                            .clone()
+                            .filter(|r| !r.trim().is_empty())
+                            .unwrap_or_else(|| "the solver produced no validated answer".into()),
+                    ),
+                ),
+                Some(solution) => match decode(solution.assignment()) {
+                    Ok((members, score)) => (Some(members), Some(score), None),
+                    Err(error) => (
+                        None,
+                        None,
+                        Some(format!(
+                            "the answer decodes to an infeasible selection and is refused: {}",
+                            error.message()
+                        )),
+                    ),
+                },
+            };
+            EntrantOutcome {
+                solver: record.solver.clone(),
+                kind: record.kind,
+                members,
+                score,
+                refusal,
+                runtime: record.runtime,
+                price: record.price,
+            }
+        })
+        .collect()
+}
+
+fn simulation_note(report: &BenchmarkReport) -> Vec<String> {
+    let mut notes = report.notes.clone();
+    notes.push(
+        "a simulator answer validates the formulation and is not evidence of quantum advantage"
+            .to_string(),
+    );
+    notes
+}
