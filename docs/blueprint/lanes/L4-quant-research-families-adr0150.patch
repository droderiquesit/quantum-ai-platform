+//! Quantum machine-learning research families: fidelity kernels and a
+//! quantum extreme-learning reservoir (R12-QUANT-1079, -1080, -4036, -4037,
+//! -4054).
+//!
+//! Neither is a QUBO, so neither goes through [`crate::benchmark`]. What they
+//! share with the combinatorial families is the rule that matters: a quantum
+//! model is never reported alone. [`QmlExperiment`] holds the quantum model's
+//! out-of-sample error and calibration beside a strong classical model's, on
+//! the same split, and the classical model is chosen without looking at the
+//! held-out data -- by validation inside the training window -- so the uplift
+//! it reports is not a comparison against a baseline picked to lose.
+//!
+//! Both quantum models run on the in-tree statevector. A simulated kernel or
+//! reservoir is a classical computation of what a device would compute; it
+//! measures whether the representation carries information, and says
+//! nothing about speed. The record's notes say so.
+//!
+//! Statistics throughout, so `f64`; nothing here is money.
+
+use crate::families::Dataset;
+use crate::foundry::FamilyKind;
+use crate::statevector::{Complex, StateVector};
+use qip_core::error::{Error, Result};
+use qip_core::{Rng, Xoshiro256};
+use qip_numerics::matrix::Matrix;
+use serde::Serialize;
+
+/// The feature map [`crate::foundry::Foundry::platform`] declares for kernels.
+pub const QUANTUM_KERNEL_ENCODING: &str =
+    "KernelRegression::feature_state (Hadamard, Z(2x), ZZ(2xy) layers)";
+/// The strong classical model the kernel family is benchmarked against.
+pub const QUANTUM_KERNEL_BASELINE: &str = "KernelRegression::rbf_kernel_ridge";
+/// The encoding declared for the reservoir.
+pub const QUANTUM_RESERVOIR_ENCODING: &str =
+    "ReservoirForecast::quantum_features (windowed RX input, seeded scrambler, <Z>, <ZZ>)";
+/// The classical models the reservoir is benchmarked against.
+pub const QUANTUM_RESERVOIR_BASELINE: &str =
+    "ReservoirForecast::classical (echo-state network or AR(window), chosen in-sample)";
+/// The benchmark both families run through.
+pub const QML_BENCHMARK: &str =
+    "qml::QmlExperiment (out-of-sample error and 95% interval coverage beside the classical model)";
+
+/// One model's fit and its out-of-sample record.
+#[derive(Clone, Debug, PartialEq, Serialize)]
+pub struct ModelScore {
+    pub model: String,
+    /// Mean squared error on the rows it was fitted on.
+    pub in_sample_mse: f64,
+    /// Mean squared error on rows it never saw (out of time, for a series).
+    pub out_of_sample_mse: f64,
+    /// Fraction of held-out targets inside the fit's 95% interval, the
+    /// interval being `1.96` training residual deviations. Calibrated is
+    /// near `0.95`; an overfitted model's narrow interval covers far less.
+    pub coverage_95: f64,
+}
+
+impl ModelScore {
+    fn validate(&self) -> Result<()> {
+        if self.model.trim().is_empty()
+            || !self.in_sample_mse.is_finite()
+            || !self.out_of_sample_mse.is_finite()
+            || !(0.0..=1.0).contains(&self.coverage_95)
+        {
+            return Err(Error::numeric(format!(
+                "model {:?} has no finite out-of-sample record",
+                self.model
+            )));
+        }
+        Ok(())
+    }
+}
+
+/// A QuantumExperiment record for a QML family.
+#[derive(Clone, Debug, PartialEq, Serialize)]
+pub struct QmlExperiment {
+    family: FamilyKind,
+    encoding: String,
+    classical_baseline: String,
+    problem_digest: String,
+    quantum: ModelScore,
+    /// The classical model the uplift is measured against.
+    classical: ModelScore,
+    /// Every classical model tried, with the validation error it was chosen
+    /// on. Recorded so the choice can be checked.
+    classical_candidates: Vec<(String, f64)>,
+    notes: Vec<String>,
+}
+
+impl QmlExperiment {
+    fn new(
+        family: FamilyKind,
+        encoding: &str,
+        classical_baseline: &str,
+        problem_digest: String,
+        quantum: ModelScore,
+        classical: ModelScore,
+        classical_candidates: Vec<(String, f64)>,
+    ) -> Result<Self> {
+        quantum.validate()?;
+        classical.validate()?;
+        if problem_digest.len() != 64 {
+            return Err(Error::invalid(
+                "a quantum experiment carries the SHA-256 of the problem it ran",
+            ));
+        }
+        Ok(Self {
+            family,
+            encoding: encoding.to_string(),
+            classical_baseline: classical_baseline.to_string(),
+            problem_digest,
+            quantum,
+            classical,
+            classical_candidates,
+            notes: vec![
+                "the quantum model ran on the in-tree statevector: this measures whether the \
+                 representation carries information, and is not evidence of quantum advantage"
+                    .to_string(),
+            ],
+        })
+    }
+
+    pub const fn family(&self) -> FamilyKind {
+        self.family
+    }
+    pub fn encoding(&self) -> &str {
+        &self.encoding
+    }
+    pub fn classical_baseline(&self) -> &str {
+        &self.classical_baseline
+    }
+    pub fn problem_digest(&self) -> &str {
+        &self.problem_digest
+    }
+    pub fn quantum(&self) -> &ModelScore {
+        &self.quantum
+    }
+    pub fn classical(&self) -> &ModelScore {
+        &self.classical
+    }
+    pub fn classical_candidates(&self) -> &[(String, f64)] {
+        &self.classical_candidates
+    }
+    pub fn notes(&self) -> &[String] {
+        &self.notes
+    }
+
+    /// Out-of-sample error the quantum model saves over the classical one:
+    /// positive means the quantum representation predicted better.
+    pub fn out_of_sample_uplift(&self) -> f64 {
+        self.classical.out_of_sample_mse - self.quantum.out_of_sample_mse
+    }
+}
+
+fn digest_of<T: Serialize>(problem: &T) -> Result<String> {
+    let bytes = serde_json::to_vec(problem)
+        .map_err(|e| Error::invalid(format!("the problem does not serialise: {e}")))?;
+    Ok(qip_core::hash::sha256_hex(&bytes))
+}
+
+fn mean(values: &[f64]) -> f64 {
+    values.iter().sum::<f64>() / values.len() as f64
+}
+
+fn mse(predicted: &[f64], actual: &[f64]) -> f64 {
+    predicted
+        .iter()
+        .zip(actual)
+        .map(|(p, a)| (p - a) * (p - a))
+        .sum::<f64>()
+        / actual.len() as f64
+}
+
+fn coverage(predicted: &[f64], actual: &[f64], sigma: f64) -> f64 {
+    let half = 1.96 * sigma;
+    let inside = predicted
+        .iter()
+        .zip(actual)
+        .filter(|(p, a)| (*p - *a).abs() <= half)
+        .count();
+    inside as f64 / actual.len() as f64
+}
+
+fn score(
+    model: &str,
+    fitted: &[f64],
+    train_target: &[f64],
+    predicted: &[f64],
+    test_target: &[f64],
+) -> ModelScore {
+    let in_sample_mse = mse(fitted, train_target);
+    ModelScore {
+        model: model.to_string(),
+        in_sample_mse,
+        out_of_sample_mse: mse(predicted, test_target),
+        coverage_95: coverage(predicted, test_target, in_sample_mse.sqrt()),
+    }
+}
+
+/// Kernel ridge regression on a precomputed Gram matrix: `alpha = (K +
+/// lambda I)^-1 (y - mean)`, predicting `mean + k(x)' alpha`.
+fn kernel_ridge(gram: &Matrix, target: &[f64], ridge: f64) -> Result<(f64, Vec<f64>)> {
+    let n = target.len();
+    let offset = mean(target);
+    let mut system = gram.clone();
+    for i in 0..n {
+        system.add_to(i, i, ridge);
+    }
+    let centred: Vec<f64> = target.iter().map(|y| y - offset).collect();
+    Ok((offset, system.solve(&centred)?))
+}
+
+/// Linear ridge with an unpenalised intercept over feature rows.
+fn linear_ridge(rows: &[Vec<f64>], target: &[f64], ridge: f64) -> Result<Vec<f64>> {
+    let p = rows.first().map_or(0, Vec::len) + 1;
+    let mut gram = Matrix::zeros(p, p);
+    let mut rhs = vec![0.0; p];
+    for (row, y) in rows.iter().zip(target) {
+        let x: Vec<f64> = std::iter::once(1.0).chain(row.iter().copied()).collect();
+        for a in 0..p {
+            rhs[a] += x[a] * y;
+            for b in 0..p {
+                gram.add_to(a, b, x[a] * x[b]);
+            }
+        }
+    }
+    for a in 1..p {
+        gram.add_to(a, a, ridge);
+    }
+    gram.solve(&rhs)
+}
+
+fn linear_predict(rows: &[Vec<f64>], beta: &[f64]) -> Vec<f64> {
+    rows.iter()
+        .map(|row| beta[0] + row.iter().zip(&beta[1..]).map(|(x, b)| x * b).sum::<f64>())
+        .collect()
+}
+
+fn inner(a: &StateVector, b: &StateVector) -> Complex {
+    a.amplitudes()
+        .iter()
+        .zip(b.amplitudes())
+        .fold(Complex::ZERO, |acc, (x, y)| {
+            acc + Complex::new(x.re, -x.im) * *y
+        })
+}
+
+/// `<Z_q>` of a state.
+fn z_expectation(state: &StateVector, qubit: usize) -> f64 {
+    state.expectation(|basis| if basis & (1 << qubit) == 0 { 1.0 } else { -1.0 })
+}
+
+/// `<Z_a Z_b>` of a state.
+fn zz_expectation(state: &StateVector, a: usize, b: usize) -> f64 {
+    state.expectation(|basis| {
+        let parity = ((basis >> a) ^ (basis >> b)) & 1;
+        if parity == 0 { 1.0 } else { -1.0 }
+    })
+}
+
+// --------------------------------------------------------------------------
+// Quantum kernels (R12-QUANT-1079, -4036)
+// --------------------------------------------------------------------------
+
+/// Regression with a fidelity quantum kernel, benchmarked against RBF
+/// kernel ridge and linear ridge on the same split.
+#[derive(Clone, Debug, PartialEq, Serialize)]
+pub struct KernelRegression {
+    pub train: Dataset,
+    pub test: Dataset,
+    pub ridge: f64,
+    /// Width of the classical RBF kernel.
+    pub rbf_gamma: f64,
+    /// Repetitions of the feature map.
+    pub layers: usize,
+}
+
+impl KernelRegression {
+    pub const MAX_FEATURES: usize = 6;
+
+    pub fn validate(&self) -> Result<()> {
+        let columns = self.train.rows.first().map_or(0, Vec::len);
+        if columns == 0 || columns > Self::MAX_FEATURES {
+            return Err(Error::invalid(format!(
+                "a quantum kernel takes 1 to {} features, one qubit each; got {columns}",
+                Self::MAX_FEATURES
+            )));
+        }
+        for (name, data) in [("training", &self.train), ("test", &self.test)] {
+            if data.rows.len() < 2 || data.rows.len() != data.target.len() {
+                return Err(Error::invalid(format!(
+                    "the {name} set needs at least two rows and one target per row"
+                )));
+            }
+            if data
+                .rows
+                .iter()
+                .any(|r| r.len() != columns || r.iter().any(|v| !v.is_finite()))
+                || data.target.iter().any(|v| !v.is_finite())
+            {
+                return Err(Error::invalid(format!(
+                    "the {name} set holds a ragged row or a non-finite value"
+                )));
+            }
+        }
+        if !self.ridge.is_finite() || self.ridge <= 0.0 {
+            return Err(Error::invalid(
+                "the ridge penalty must be positive and finite",
+            ));
+        }
+        if !self.rbf_gamma.is_finite() || self.rbf_gamma <= 0.0 {
+            return Err(Error::invalid("the RBF width must be positive and finite"));
+        }
+        if self.layers == 0 || self.layers > 3 {
+            return Err(Error::invalid("the feature map repeats 1 to 3 times"));
+        }
+        Ok(())
+    }
+
+    /// `|phi(x)>`: per layer, Hadamard on every qubit, `RZ(2 x_i)`, then a
+    /// `ZZ` phase of `2 x_i x_j` on every pair.
+    pub fn feature_state(&self, x: &[f64]) -> Result<StateVector> {
+        let mut state = StateVector::zero(x.len())?;
+        for _ in 0..self.layers {
+            for (i, v) in x.iter().enumerate() {
+                state.hadamard(i)?;
+                state.rotate_z(i, 2.0 * v)?;
+            }
+            for i in 0..x.len() {
+                for j in (i + 1)..x.len() {
+                    state.controlled_phase(i, j, 2.0 * x[i] * x[j])?;
+                }
+            }
+        }
+        Ok(state)
+    }
+
+    /// `|<phi(a)|phi(b)>|^2`, a fidelity in `[0, 1]`.
+    pub fn quantum_kernel(&self, a: &[f64], b: &[f64]) -> Result<f64> {
+        if a.len() != b.len() {
+            return Err(Error::invalid("a kernel compares points of one dimension"));
+        }
+        let overlap = inner(&self.feature_state(a)?, &self.feature_state(b)?);
+        Ok(overlap.norm_squared())
+    }
+
+    fn rbf(&self, a: &[f64], b: &[f64]) -> f64 {
+        let d: f64 = a.iter().zip(b).map(|(x, y)| (x - y) * (x - y)).sum();
+        (-self.rbf_gamma * d).exp()
+    }
+
+    fn kernel_model<F>(&self, name: &str, k: F) -> Result<ModelScore>
+    where
+        F: Fn(&[f64], &[f64]) -> Result<f64>,
+    {
+        let n = self.train.rows.len();
+        let mut gram = Matrix::zeros(n, n);
+        for i in 0..n {
+            for j in 0..n {
+                gram.set(i, j, k(&self.train.rows[i], &self.train.rows[j])?);
+            }
+        }
+        let (offset, alpha) = kernel_ridge(&gram, &self.train.target, self.ridge)?;
+        let predict = |x: &[f64]| -> Result<f64> {
+            let mut total = offset;
+            for (row, a) in self.train.rows.iter().zip(&alpha) {
+                total += a * k(x, row)?;
+            }
+            Ok(total)
+        };
+        let fitted = self
+            .train
+            .rows
+            .iter()
+            .map(|x| predict(x))
+            .collect::<Result<Vec<_>>>()?;
+        let predicted = self
+            .test
+            .rows
+            .iter()
+            .map(|x| predict(x))
+            .collect::<Result<Vec<_>>>()?;
+        Ok(score(
+            name,
+            &fitted,
+            &self.train.target,
+            &predicted,
+            &self.test.target,
+        ))
+    }
+
+    /// Run the quantum kernel and the classical candidates. The classical
+    /// baseline is chosen by leave-out validation inside the training set,
+    /// never on the test rows.
+    pub fn run_experiment(&self) -> Result<QmlExperiment> {
+        self.validate()?;
+        let quantum =
+            self.kernel_model("quantum-fidelity-kernel", |a, b| self.quantum_kernel(a, b))?;
+        let rbf = self.kernel_model("rbf-kernel-ridge", |a, b| Ok(self.rbf(a, b)))?;
+        let beta = linear_ridge(&self.train.rows, &self.train.target, self.ridge)?;
+        let linear = score(
+            "linear-ridge",
+            &linear_predict(&self.train.rows, &beta),
+            &self.train.target,
+            &linear_predict(&self.test.rows, &beta),
+            &self.test.target,
+        );
+        let candidates = vec![
+            ("rbf-kernel-ridge".to_string(), self.validation_error(true)?),
+            ("linear-ridge".to_string(), self.validation_error(false)?),
+        ];
+        let classical = if candidates[0].1 <= candidates[1].1 {
+            rbf
+        } else {
+            linear
+        };
+        QmlExperiment::new(
+            FamilyKind::KernelsAndVariationalModels,
+            QUANTUM_KERNEL_ENCODING,
+            QUANTUM_KERNEL_BASELINE,
+            digest_of(self)?,
+            quantum,
+            classical,
+            candidates,
+        )
+    }
+
+    /// Error on the last quarter of the training rows of a model fitted on
+    /// the first three quarters.
+    fn validation_error(&self, rbf: bool) -> Result<f64> {
+        let n = self.train.rows.len();
+        let cut = (n * 3 / 4).clamp(1, n - 1);
+        let inner = KernelRegression {
+            train: Dataset {
+                rows: self.train.rows[..cut].to_vec(),
+                target: self.train.target[..cut].to_vec(),
+            },
+            test: Dataset {
+                rows: self.train.rows[cut..].to_vec(),
+                target: self.train.target[cut..].to_vec(),
+            },
+            ..self.clone()
+        };
+        if rbf {
+            Ok(inner
+                .kernel_model("rbf", |a, b| Ok(inner.rbf(a, b)))?
+                .out_of_sample_mse)
+        } else {
+            let beta = linear_ridge(&inner.train.rows, &inner.train.target, self.ridge)?;
+            Ok(mse(
+                &linear_predict(&inner.test.rows, &beta),
+                &inner.test.target,
+            ))
+        }
+    }
+}
+
+// --------------------------------------------------------------------------
+// Quantum reservoir / extreme learning (R12-QUANT-1080, -4037, -4054)
+// --------------------------------------------------------------------------
+
+/// One-step-ahead forecasting of a series: a quantum extreme-learning
+/// reservoir against an echo-state network and a linear AR model, scored
+/// out of time.
+#[derive(Clone, Debug, PartialEq, Serialize)]
+pub struct ReservoirForecast {
+    pub series: Vec<f64>,
+    /// Observations `0..train_len` are the training period; everything after
+    /// is out of time.
+    pub train_len: usize,
+    /// Past values each forecast reads.
+    pub window: usize,
+    pub qubits: usize,
+    pub ridge: f64,
+    pub seed: u64,
+}
+
+impl ReservoirForecast {
+    pub const MAX_QUBITS: usize = 6;
+
+    pub fn validate(&self) -> Result<()> {
+        if self.series.iter().any(|v| !v.is_finite()) {
+            return Err(Error::invalid("the series holds a non-finite value"));
+        }
+        if self.window == 0 || self.window > 8 {
+            return Err(Error::invalid("the window reads 1 to 8 past values"));
+        }
+        if self.qubits < 2 || self.qubits > Self::MAX_QUBITS {
+            return Err(Error::invalid(format!(
+                "the reservoir has 2 to {} qubits",
+                Self::MAX_QUBITS
+            )));
+        }
+        if self.train_len < self.window + 12 {
+            return Err(Error::invalid(
+                "the training period must hold at least twelve forecasts beyond the window",
+            ));
+        }
+        if self.series.len() < self.train_len + 5 {
+            return Err(Error::invalid(
+                "at least five out-of-time observations are needed to score a forecast",
+            ));
+        }
+        if !self.ridge.is_finite() || self.ridge <= 0.0 {
+            return Err(Error::invalid(
+                "the ridge penalty must be positive and finite",
+            ));
+        }
+        let scale = self.input_scale();
+        if !scale.is_finite() || scale <= 0.0 {
+            return Err(Error::invalid(
+                "the training period is constant, so there is nothing to forecast",
+            ));
+        }
+        Ok(())
+    }
+
+    /// Rotation per unit of input, from the training period alone: a scale
+    /// taken over the whole series would let out-of-time values shape the
+    /// features the model is fitted on.
+    fn input_scale(&self) -> f64 {
+        let peak = self.series[..self.train_len]
+            .iter()
+            .fold(0.0_f64, |m, v| m.max(v.abs()));
+        std::f64::consts::PI / peak
+    }
+
+    /// Indices `t` of forecasts, each reading `series[t + 1 - window..=t]`
+    /// and predicting `series[t + 1]`.
+    fn forecast_points(&self) -> std::ops::Range<usize> {
+        (self.window - 1)..(self.series.len() - 1)
+    }
+
+    fn is_training(&self, t: usize) -> bool {
+        t + 1 < self.train_len
+    }
+
+    /// The scrambler: seeded single-qubit rotations then a CNOT ring, fixed
+    /// for the run.
+    fn scrambler(&self) -> Vec<(f64, f64)> {
+        let mut rng = Xoshiro256::seeded(self.seed);
+        (0..self.qubits)
+            .map(|_| {
+                (
+                    rng.uniform(0.0, std::f64::consts::TAU),
+                    rng.uniform(0.0, std::f64::consts::TAU),
+                )
+            })
+            .collect()
+    }
+
+    /// `<Z_i>` and `<Z_i Z_j>` after the window is fed in, one value per
+    /// step: `RX(scale * u)` on qubit 0, then the scrambler.
+    pub fn quantum_features(&self) -> Result<Vec<Vec<f64>>> {
+        let scale = self.input_scale();
+        let scrambler = self.scrambler();
+        self.forecast_points()
+            .map(|t| {
+                let mut state = StateVector::zero(self.qubits)?;
+                for u in &self.series[t + 1 - self.window..=t] {
+                    state.rotate_x(0, scale * u)?;
+                    for (q, (theta, phi)) in scrambler.iter().enumerate() {
+                        state.rotate_x(q, *theta)?;
+                        state.rotate_z(q, *phi)?;
+                    }
+                    for q in 0..self.qubits {
+                        state.cnot(q, (q + 1) % self.qubits)?;
+                    }
+                }
+                let mut row: Vec<f64> =
+                    (0..self.qubits).map(|q| z_expectation(&state, q)).collect();
+                for a in 0..self.qubits {
+                    for b in (a + 1)..self.qubits {
+                        row.push(zz_expectation(&state, a, b));
+                    }
+                }
+                Ok(row)
+            })
+            .collect()
+    }
+
+    /// An echo-state network of as many units as the quantum features, run
+    /// causally over the series; its weights' largest absolute row sum is
+    /// scaled to 0.9 so the state forgets.
+    fn echo_state_features(&self) -> Vec<Vec<f64>> {
+        let units = self.qubits + self.qubits * (self.qubits - 1) / 2;
+        let mut rng = Xoshiro256::seeded(self.seed).fork("echo-state");
+        let w_in: Vec<f64> = (0..units).map(|_| rng.uniform(-1.0, 1.0)).collect();
+        let mut w: Vec<Vec<f64>> = (0..units)
+            .map(|_| (0..units).map(|_| rng.uniform(-1.0, 1.0)).collect())
+            .collect();
+        let widest = w
+            .iter()
+            .map(|r| r.iter().map(|v| v.abs()).sum::<f64>())
+            .fold(0.0_f64, f64::max);
+        for row in &mut w {
+            for v in row.iter_mut() {
+                *v *= 0.9 / widest;
+            }
+        }
+        let scale = self.input_scale() / std::f64::consts::PI;
+        let mut state = vec![0.0; units];
+        let mut by_time = Vec::with_capacity(self.series.len());
+        for u in &self.series {
+            state = (0..units)
+                .map(|i| {
+                    let recurrent: f64 = w[i].iter().zip(&state).map(|(a, b)| a * b).sum();
+                    (recurrent + w_in[i] * scale * u).tanh()
+                })
+                .collect();
+            by_time.push(state.clone());
+        }
+        self.forecast_points().map(|t| by_time[t].clone()).collect()
+    }
+
+    fn autoregressive_features(&self) -> Vec<Vec<f64>> {
+        self.forecast_points()
+            .map(|t| self.series[t + 1 - self.window..=t].to_vec())
+            .collect()
+    }
+
+    fn readout(&self, name: &str, features: &[Vec<f64>]) -> Result<ModelScore> {
+        let (train, test) = self.split(features);
+        let beta = linear_ridge(&train.rows, &train.target, self.ridge)?;
+        Ok(score(
+            name,
+            &linear_predict(&train.rows, &beta),
+            &train.target,
+            &linear_predict(&test.rows, &beta),
+            &test.target,
+        ))
+    }
+
+    fn split(&self, features: &[Vec<f64>]) -> (Dataset, Dataset) {
+        let mut train = Dataset {
+            rows: Vec::new(),
+            target: Vec::new(),
+        };
+        let mut test = train.clone();
+        for (row, t) in features.iter().zip(self.forecast_points()) {
+            let into = if self.is_training(t) {
+                &mut train
+            } else {
+                &mut test
+            };
+            into.rows.push(row.clone());
+            into.target.push(self.series[t + 1]);
+        }
+        (train, test)
+    }
+
+    /// Validation error inside the training period: fit on its first three
+    /// quarters, score on the last.
+    fn validation_error(&self, features: &[Vec<f64>]) -> Result<f64> {
+        let (train, _) = self.split(features);
+        let cut = train.rows.len() * 3 / 4;
+        let beta = linear_ridge(&train.rows[..cut], &train.target[..cut], self.ridge)?;
+        Ok(mse(
+            &linear_predict(&train.rows[cut..], &beta),
+            &train.target[cut..],
+        ))
+    }
+
+    pub fn run_experiment(&self) -> Result<QmlExperiment> {
+        self.validate()?;
+        let quantum_rows = self.quantum_features()?;
+        let quantum = self.readout("quantum-reservoir", &quantum_rows)?;
+        let echo = self.echo_state_features();
+        let ar = self.autoregressive_features();
+        let candidates = vec![
+            (
+                "echo-state-network".to_string(),
+                self.validation_error(&echo)?,
+            ),
+            (format!("ar-{}", self.window), self.validation_error(&ar)?),
+        ];
+        let classical = if candidates[0].1 <= candidates[1].1 {
+            self.readout("echo-state-network", &echo)?
+        } else {
+            self.readout(&format!("ar-{}", self.window), &ar)?
+        };
+        QmlExperiment::new(
+            FamilyKind::ReservoirAndExtremeLearning,
+            QUANTUM_RESERVOIR_ENCODING,
+            QUANTUM_RESERVOIR_BASELINE,
+            digest_of(self)?,
+            quantum,
+            classical,
+            candidates,
+        )
+    }
+}
diff --git a/backend/crates/libs/qip-quantum/tests/families.rs b/backend/crates/libs/qip-quantum/tests/families.rs
new file mode 100644
index 00000000..0ac80dc2
--- /dev/null
+++ b/backend/crates/libs/qip-quantum/tests/families.rs
@@ -0,0 +1,379 @@
+//! The foundry's combinatorial research families, run end to end: encoding,
+//! classical baseline, QUBO benchmark with a quantum entrant on the in-tree
+//! statevector, and every answer decoded and re-scored on the family's own
+//! measure (R12-QUANT-1077, -1078, -1081, -4035, -4038, -4041, -4059).
+//!
+//! Each test asserts its premise before its claim, and names the mutation
+//! that should make it fail.
+
+#![allow(clippy::panic_in_result_fn)]
+#![allow(clippy::unwrap_used, clippy::expect_used)] // a panic is the failure report
+
+use qip_core::error::Result;
+use qip_quantum::benchmark::SolverBenchmark;
+use qip_quantum::families::{
+    ConflictGraph, Dataset, FEATURE_SELECTION_BASELINE, FEATURE_SELECTION_ENCODING,
+    FamilyExperiment, FeatureSelection, GRAPH_SEARCH_ENCODING, GraphCandidate, Scenario,
+    ScenarioSelection,
+};
+use qip_quantum::foundry::FamilyKind;
+use qip_quantum::provider::SimulatedProvider;
+use qip_quantum::qaoa::QaoaSettings;
+use qip_quantum::solver::{ClassicalSolver, ProviderSolver, SolverKind};
+use std::collections::BTreeSet;
+use std::sync::Arc;
+
+fn benchmark() -> SolverBenchmark {
+    SolverBenchmark::new(ClassicalSolver::exhaustive(20))
+        .with_solver(Arc::new(ProviderSolver::new(
+            Arc::new(SimulatedProvider::new(11)),
+            QaoaSettings {
+                layers: 2,
+                optimiser_iterations: 60,
+                shots: 0,
+            },
+        )))
+        .with_repeats(1)
+}
+
+/// A deterministic pseudo-random stream in `[-1, 1)`, so the data is fixed.
+fn stream(seed: u64) -> impl FnMut() -> f64 {
+    let mut state = seed.wrapping_mul(6_364_136_223_846_793_005).wrapping_add(1);
+    move || {
+        state = state
+            .wrapping_mul(6_364_136_223_846_793_005)
+            .wrapping_add(1_442_695_040_888_963_407);
+        ((state >> 11) as f64 / (1u64 << 53) as f64) * 2.0 - 1.0
+    }
+}
+
+/// Six candidate features: the target is `2 x0 - x3` plus noise; `x1` is a
+/// near-copy of `x0`; the rest are noise.
+fn dataset(rows: usize, seed: u64) -> Dataset {
+    let mut next = stream(seed);
+    let mut out = Dataset {
+        rows: Vec::new(),
+        target: Vec::new(),
+    };
+    for _ in 0..rows {
+        let x0 = next();
+        let x3 = next();
+        let row = vec![x0, x0 + 0.05 * next(), next(), x3, next(), next()];
+        out.target.push(2.0 * x0 - x3 + 0.1 * next());
+        out.rows.push(row);
+    }
+    out
+}
+
+fn features() -> FeatureSelection {
+    FeatureSelection {
+        train: dataset(60, 1),
+        held_out: dataset(40, 2),
+        select: 2,
+        redundancy_weight: 1.0,
+        ridge: 1e-3,
+    }
+}
+
+fn quantum(experiment: &FamilyExperiment) -> &qip_quantum::families::EntrantOutcome {
+    experiment
+        .entrants()
+        .iter()
+        .find(|e| e.kind == SolverKind::Quantum)
+        .expect("a quantum entrant ran")
+}
+
+fn classical(experiment: &FamilyExperiment) -> &qip_quantum::families::EntrantOutcome {
+    experiment
+        .entrants()
+        .iter()
+        .find(|e| e.kind == SolverKind::Classical)
+        .expect("the QUBO's classical solve is recorded")
+}
+
+/// R12-QUANT-1078, -4035, -4059: feature selection is encoded, solved by a
+/// quantum entrant and the exhaustive classical solver, and every answer is
+/// scored on held-out loss beside the greedy selector, with the uplift and
+/// the compute each cost reported.
+///
+/// Mutation: drop the redundancy term from `FeatureSelection::to_qubo` -- the
+/// QUBO's optimum keeps the duplicated pair `{0, 1}` and the held-out loss
+/// assertion fails.
+#[test]
+fn feature_selection_is_benchmarked_on_held_out_loss_against_the_greedy_selector() -> Result<()> {
+    let problem = features();
+    let experiment = problem.run_experiment(&benchmark())?;
+
+    assert_eq!(experiment.family(), FamilyKind::FeatureEnsembleSelection);
+    assert_eq!(experiment.encoding(), FEATURE_SELECTION_ENCODING);
+    assert_eq!(experiment.classical_baseline(), FEATURE_SELECTION_BASELINE);
+    assert_eq!(experiment.problem_digest().len(), 64);
+
+    // Both drivers, and one copy of `x0` -- `x0` and its near-copy `x1` are
+    // interchangeable, the pair of them is not.
+    let drivers = |members: &[usize]| {
+        members.len() == 2 && members.contains(&3) && (members.contains(&0) ^ members.contains(&1))
+    };
+    assert!(
+        drivers(&experiment.baseline().members),
+        "the greedy selector keeps the two drivers: {:?}",
+        experiment.baseline().members
+    );
+    let exhaustive = classical(&experiment);
+    assert!(
+        exhaustive.members.as_deref().is_some_and(drivers),
+        "the QUBO's optimum is the relevant, non-redundant pair: {:?}",
+        exhaustive.members
+    );
+    let loss = exhaustive.score.expect("scored");
+    assert!(loss < 0.05, "held-out loss of the true drivers: {loss}");
+    // A selection of the duplicated pair predicts far worse out of sample:
+    // the measure, not the QUBO energy, is what the record scores.
+    assert!(problem.held_out_loss(&[0, 1])? > 10.0 * loss);
+
+    let q = quantum(&experiment);
+    assert!(
+        q.score.is_some() ^ q.refusal.is_some(),
+        "a quantum entrant holds exactly one of a score and a refusal"
+    );
+    if q.score.is_some() {
+        assert!(experiment.quantum_uplift().is_some());
+    }
+    assert!(experiment.uplift_of(exhaustive).expect("scored").abs() < 1e-12);
+    assert!(
+        experiment
+            .notes()
+            .iter()
+            .any(|n| n.contains("not evidence of quantum advantage"))
+    );
+    Ok(())
+}
+
+/// R12-QUANT-4035: a selection keeping the wrong number of features is
+/// refused at decode, and the held-out set never reaches the encoding.
+///
+/// Mutation: delete the cardinality check in `FeatureSelection::decode` --
+/// the three-feature assignment decodes and `unwrap_err` panics.
+#[test]
+fn a_selection_of_the_wrong_size_is_refused_and_the_held_out_set_never_shapes_the_qubo()
+-> Result<()> {
+    let problem = features();
+    assert!(problem.decode(&[1, 0, 0, 1, 0, 0]).is_ok(), "premise");
+    let refused = problem.decode(&[1, 0, 1, 1, 0, 0]).unwrap_err();
+    assert!(
+        refused.message().contains("exactly 2"),
+        "{}",
+        refused.message()
+    );
+
+    let mut peeked = problem.clone();
+    peeked.held_out = dataset(40, 99);
+    assert_ne!(
+        peeked.held_out, problem.held_out,
+        "premise: a different held-out set"
+    );
+    assert_eq!(peeked.to_qubo()?.entries, problem.to_qubo()?.entries);
+    assert_eq!(peeked.greedy_forward()?, problem.greedy_forward()?);
+    Ok(())
+}
+
+#[test]
+fn a_feature_problem_with_a_bad_input_is_refused_rather_than_repaired() {
+    let mut nan = features();
+    nan.train.rows[3][2] = f64::NAN;
+    assert!(nan.validate().is_err());
+    let mut zero = features();
+    zero.select = 0;
+    assert!(zero.validate().is_err());
+    let mut negative = features();
+    negative.redundancy_weight = -0.1;
+    assert!(negative.validate().is_err());
+    assert!(features().validate().is_ok(), "premise");
+}
+
+fn scenario(id: &str, information: f64, cost: u32, hypothesis: &str, minority: bool) -> Scenario {
+    Scenario {
+        id: id.to_string(),
+        information,
+        cost,
+        hypothesis: hypothesis.to_string(),
+        minority,
+    }
+}
+
+/// Five scenarios testing a consensus view and two testing minority views;
+/// the consensus runs are informative and cheap, so a selector that ignored
+/// the minority rule would spend the budget on them alone.
+fn scenarios() -> ScenarioSelection {
+    let list = vec![
+        scenario("rates-up-a", 5.0, 2, "consensus", false),
+        scenario("rates-up-b", 4.8, 2, "consensus", false),
+        scenario("rates-up-c", 4.5, 2, "consensus", false),
+        scenario("supply-shock", 2.0, 3, "minority-supply", true),
+        scenario("fx-break", 1.5, 2, "minority-fx", true),
+        scenario("rates-flat", 3.0, 1, "consensus", false),
+    ];
+    let n = list.len();
+    let mut similarity = vec![vec![0.0; n]; n];
+    for (i, row) in similarity.iter_mut().enumerate() {
+        row[i] = 1.0;
+    }
+    // The three rates-up runs largely repeat one another.
+    for (i, j) in [(0, 1), (0, 2), (1, 2)] {
+        similarity[i][j] = 0.8;
+        similarity[j][i] = 0.8;
+    }
+    ScenarioSelection {
+        scenarios: list,
+        similarity,
+        budget: 7,
+        overlap_weight: 1.0,
+    }
+}
+
+/// The best admissible selection by brute force: what a correct encoding's
+/// minimum must decode to.
+fn brute_force(problem: &ScenarioSelection) -> (Vec<usize>, f64) {
+    let n = problem.scenarios.len();
+    let mut best: Option<(Vec<usize>, f64)> = None;
+    for mask in 0u32..(1 << n) {
+        let members: Vec<usize> = (0..n).filter(|i| mask & (1 << i) != 0).collect();
+        if problem.check(&members).is_err() {
+            continue;
+        }
+        let value = problem.value(&members);
+        if best.as_ref().is_none_or(|(_, b)| value > *b) {
+            best = Some((members, value));
+        }
+    }
+    best.expect("an admissible selection exists")
+}
+
+/// R12-QUANT-1081, -4038: scenario selection under a compute budget is
+/// encoded with budget and minority slack, its QUBO minimum decodes to the
+/// brute-force optimum, and the greedy selector and a quantum entrant are
+/// scored on the same measure.
+///
+/// Mutation: drop the budget equality from `ScenarioSelection::to_qubo` --
+/// the QUBO's minimum takes every scenario, decodes over budget and is
+/// refused, and the exhaustive entrant's `members` assertion fails.
+#[test]
+fn scenario_selection_under_a_budget_decodes_to_the_brute_force_optimum() -> Result<()> {
+    let problem = scenarios();
+    let (optimum, value) = brute_force(&problem);
+    let experiment = problem.run_experiment(&benchmark())?;
+    assert_eq!(experiment.family(), FamilyKind::ScenarioHypothesisSelection);
+
+    let exhaustive = classical(&experiment);
+    assert_eq!(exhaustive.members.as_deref(), Some(&optimum[..]));
+    assert!((exhaustive.score.expect("scored") - value).abs() < 1e-9);
+    // The greedy baseline is admissible and no better than the optimum.
+    problem.check(&experiment.baseline().members)?;
+    assert!(experiment.baseline().score <= value + 1e-9);
+
+    let q = quantum(&experiment);
+    if let Some(members) = &q.members {
+        problem.check(members)?;
+    } else {
+        assert!(q.refusal.is_some());
+    }
+    Ok(())
+}
+
+/// R12-QUANT-4041: a selection that drops every minority hypothesis is
+/// refused, however much information it buys.
+///
+/// Mutation: delete the minority clause in `ScenarioSelection::check` -- the
+/// consensus-only selection is admitted and `unwrap_err` panics.
+#[test]
+fn a_selection_that_drops_every_minority_hypothesis_is_refused() {
+    let problem = scenarios();
+    let consensus_only = vec![0, 1, 2, 5];
+    // Premise: it fits the budget and buys more information than anything
+    // with a minority run in it, so only the minority rule can refuse it.
+    // The comparison is by hand, not through `check`, so the premise does
+    // not lean on the rule under test: [0, 1, 4, 5] is the best selection
+    // that keeps a minority run.
+    let cost =
+        |members: &[usize]| -> u32 { members.iter().map(|&i| problem.scenarios[i].cost).sum() };
+    let with_minority = [0, 1, 4, 5];
+    assert!(problem.scenarios[4].minority);
+    assert!(cost(&consensus_only) <= problem.budget);
+    assert!(cost(&with_minority) <= problem.budget);
+    assert!(problem.value(&consensus_only) > problem.value(&with_minority));
+
+    let refused = problem.check(&consensus_only).unwrap_err();
+    assert!(
+        refused.message().contains("minority hypothesis"),
+        "{}",
+        refused.message()
+    );
+    let decoded = problem
+        .decode(&{
+            let mut bits = vec![0u8; problem.to_qubo().unwrap().n];
+            for i in &consensus_only {
+                bits[*i] = 1;
+            }
+            bits
+        })
+        .unwrap_err();
+    assert!(decoded.message().contains("minority hypothesis"));
+}
+
+fn candidate(id: &str, weight: f64, resources: &[&str]) -> GraphCandidate {
+    GraphCandidate {
+        id: id.to_string(),
+        weight,
+        resources: resources.iter().map(|r| (*r).to_string()).collect(),
+    }
+}
+
+/// Six multi-leg cycles over shared inventory: greedy-by-weight takes the
+/// heaviest and is locked out of a better pair.
+fn graph() -> ConflictGraph {
+    ConflictGraph {
+        candidates: vec![
+            candidate("btc-eth-usdt", 10.0, &["btc", "eth"]),
+            candidate("btc-sol", 6.0, &["btc", "sol"]),
+            candidate("eth-ada", 6.0, &["eth", "ada"]),
+            candidate("xrp-dot", 3.0, &["xrp", "dot"]),
+            candidate("dot-ltc", 2.0, &["dot", "ltc"]),
+            candidate("ltc-xlm", 2.5, &["ltc", "xlm"]),
+        ],
+    }
+}
+
+/// R12-QUANT-1077: graph search (a maximum-weight conflict-free set) is
+/// encoded, its QUBO minimum is the brute-force optimum, and it is
+/// benchmarked against the greedy search, which it beats on this instance.
+///
+/// Mutation: lower the conflict penalty in `ConflictGraph::to_qubo` to
+/// `0.5 * heaviest` -- the QUBO's minimum keeps a conflicting pair, decodes
+/// to a refusal and the `members` assertion fails.
+#[test]
+fn graph_search_is_benchmarked_against_the_greedy_search_and_decodes_conflict_free() -> Result<()> {
+    let problem = graph();
+    let experiment = problem.run_experiment(&benchmark())?;
+    assert_eq!(experiment.family(), FamilyKind::GraphSearch);
+    assert_eq!(experiment.encoding(), GRAPH_SEARCH_ENCODING);
+
+    // Premise: greedy takes the 10 and is locked out of 6 + 6.
+    assert_eq!(experiment.baseline().members, vec![0, 3, 5]);
+    let exhaustive = classical(&experiment);
+    assert_eq!(exhaustive.members.as_deref(), Some(&[1, 2, 3, 5][..]));
+    assert!(experiment.uplift_of(exhaustive).expect("scored") > 0.0);
+
+    let refused = problem.decode(&[1, 1, 0, 0, 0, 0]).unwrap_err();
+    assert!(refused.message().contains("share a resource"));
+    let q = quantum(&experiment);
+    assert!(q.score.is_some() ^ q.refusal.is_some());
+    Ok(())
+}
+
+#[test]
+fn a_graph_candidate_holding_no_resource_is_refused() {
+    let mut problem = graph();
+    assert!(problem.validate().is_ok(), "premise");
+    problem.candidates[2].resources = BTreeSet::new();
+    assert!(problem.validate().is_err());
+}
