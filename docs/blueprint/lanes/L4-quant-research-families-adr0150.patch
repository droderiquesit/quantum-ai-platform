index 00000000..dda29c02
--- /dev/null
+++ b/backend/crates/libs/qip-quantum/tests/qml.rs
@@ -0,0 +1,214 @@
+//! Quantum kernel and quantum reservoir research families, each benchmarked
+//! out of sample against a classical model chosen without the held-out data
+//! (R12-QUANT-1079, -1080, -4036, -4037, -4054).
+//!
+//! Each test names the mutation that should make it fail.
+
+#![allow(clippy::panic_in_result_fn)]
+#![allow(clippy::unwrap_used, clippy::expect_used)] // a panic is the failure report
+
+use qip_core::error::Result;
+use qip_quantum::families::Dataset;
+use qip_quantum::foundry::FamilyKind;
+use qip_quantum::qml::{
+    KernelRegression, QUANTUM_KERNEL_ENCODING, QUANTUM_RESERVOIR_ENCODING, ReservoirForecast,
+};
+
+fn stream(seed: u64) -> impl FnMut() -> f64 {
+    let mut state = seed.wrapping_mul(6_364_136_223_846_793_005).wrapping_add(1);
+    move || {
+        state = state
+            .wrapping_mul(6_364_136_223_846_793_005)
+            .wrapping_add(1_442_695_040_888_963_407);
+        ((state >> 11) as f64 / (1u64 << 53) as f64) * 2.0 - 1.0
+    }
+}
+
+fn points(rows: usize, seed: u64) -> Dataset {
+    let mut next = stream(seed);
+    let mut out = Dataset {
+        rows: Vec::new(),
+        target: Vec::new(),
+    };
+    for _ in 0..rows {
+        let (a, b) = (next(), next());
+        out.target.push((2.0 * a * b).cos() + 0.05 * next());
+        out.rows.push(vec![a, b]);
+    }
+    out
+}
+
+fn kernel() -> KernelRegression {
+    KernelRegression {
+        train: points(40, 3),
+        test: points(30, 4),
+        ridge: 1e-2,
+        rbf_gamma: 1.0,
+        layers: 2,
+    }
+}
+
+/// The fidelity kernel is a kernel: one on the diagonal, symmetric, in
+/// `[0, 1]`, and below one for distinct points.
+///
+/// Mutation: drop the conjugate in `qml::inner` -- `k(x, x)` is no longer one
+/// and the diagonal assertion fails.
+#[test]
+fn the_quantum_kernel_is_a_fidelity_one_on_the_diagonal_and_symmetric() -> Result<()> {
+    let model = kernel();
+    let (a, b) = (vec![0.3, -0.7], vec![-0.4, 0.9]);
+    assert!((model.quantum_kernel(&a, &a)? - 1.0).abs() < 1e-12);
+    let ab = model.quantum_kernel(&a, &b)?;
+    assert!((ab - model.quantum_kernel(&b, &a)?).abs() < 1e-12);
+    assert!((0.0..1.0).contains(&ab), "{ab}");
+    Ok(())
+}
+
+/// R12-QUANT-1079, -4036: the kernel experiment reports the quantum model's
+/// out-of-sample error and calibration beside the classical model's, and
+/// the classical model is chosen by validation inside the training set: a
+/// different test set changes neither the candidates' validation errors nor
+/// the choice.
+///
+/// Mutation: make `KernelRegression::validation_error` validate on
+/// `self.test` -- the candidates' errors move with the test set and the
+/// equality fails.
+#[test]
+fn the_kernel_experiment_reports_uplift_against_a_classical_model_chosen_without_the_test_set()
+-> Result<()> {
+    let model = kernel();
+    let experiment = model.run_experiment()?;
+    assert_eq!(experiment.family(), FamilyKind::KernelsAndVariationalModels);
+    assert_eq!(experiment.encoding(), QUANTUM_KERNEL_ENCODING);
+    assert_eq!(experiment.problem_digest().len(), 64);
+    let (q, c) = (experiment.quantum(), experiment.classical());
+    assert_eq!(q.model, "quantum-fidelity-kernel");
+    assert!(q.out_of_sample_mse.is_finite() && c.out_of_sample_mse.is_finite());
+    assert!((0.0..=1.0).contains(&q.coverage_95) && (0.0..=1.0).contains(&c.coverage_95));
+    assert!(
+        (experiment.out_of_sample_uplift() - (c.out_of_sample_mse - q.out_of_sample_mse)).abs()
+            < 1e-15
+    );
+    // The chosen classical model is the candidate with the lower
+    // validation error.
+    let best = experiment
+        .classical_candidates()
+        .iter()
+        .min_by(|a, b| a.1.partial_cmp(&b.1).unwrap())
+        .unwrap();
+    assert_eq!(c.model, best.0);
+
+    let mut other = model.clone();
+    other.test = points(30, 77);
+    assert_ne!(other.test, model.test, "premise: a different test set");
+    let again = other.run_experiment()?;
+    assert_eq!(
+        again.classical_candidates(),
+        experiment.classical_candidates()
+    );
+    assert_eq!(again.classical().model, c.model);
+    assert_eq!(
+        again.quantum().in_sample_mse.to_bits(),
+        q.in_sample_mse.to_bits()
+    );
+    assert_ne!(
+        again.quantum().out_of_sample_mse.to_bits(),
+        q.out_of_sample_mse.to_bits()
+    );
+    Ok(())
+}
+
+#[test]
+fn a_kernel_problem_with_a_bad_input_is_refused() {
+    let mut wide = kernel();
+    wide.train.rows[0].push(0.1);
+    assert!(wide.validate().is_err());
+    let mut zero = kernel();
+    zero.ridge = 0.0;
+    assert!(zero.validate().is_err());
+    assert!(kernel().validate().is_ok(), "premise");
+}
+
+fn series() -> Vec<f64> {
+    let mut next = stream(9);
+    (0..120)
+        .map(|t| {
+            let t = f64::from(t);
+            (0.4 * t).sin() + 0.5 * (0.9 * t).sin().powi(2) + 0.05 * next()
+        })
+        .collect()
+}
+
+fn reservoir() -> ReservoirForecast {
+    ReservoirForecast {
+        series: series(),
+        train_len: 80,
+        window: 4,
+        qubits: 3,
+        ridge: 1e-4,
+        seed: 5,
+    }
+}
+
+/// R12-QUANT-1080, -4037, -4054: the reservoir forecasts out of time and
+/// reports its error and interval coverage beside the classical reservoir or
+/// AR model chosen in-sample, and nothing after the training period shapes
+/// the fit: blowing up every out-of-time value leaves both in-sample fits and
+/// the classical choice exactly as they were.
+///
+/// Mutation: take `ReservoirForecast::input_scale` over the whole series --
+/// the out-of-time peak rescales the training features and the quantum
+/// in-sample equality fails.
+#[test]
+fn the_reservoir_forecasts_out_of_time_beside_a_classical_model_and_the_future_never_shapes_the_fit()
+-> Result<()> {
+    let model = reservoir();
+    let experiment = model.run_experiment()?;
+    assert_eq!(experiment.family(), FamilyKind::ReservoirAndExtremeLearning);
+    assert_eq!(experiment.encoding(), QUANTUM_RESERVOIR_ENCODING);
+    let (q, c) = (experiment.quantum(), experiment.classical());
+    assert_eq!(q.model, "quantum-reservoir");
+    assert!(q.out_of_sample_mse.is_finite() && c.out_of_sample_mse.is_finite());
+    assert!((0.0..=1.0).contains(&q.coverage_95) && (0.0..=1.0).contains(&c.coverage_95));
+    // The quantum features carry information: the reservoir forecasts far
+    // better than the series' own variance.
+    let tail = &model.series[model.train_len..];
+    let m = tail.iter().sum::<f64>() / tail.len() as f64;
+    let variance = tail.iter().map(|v| (v - m) * (v - m)).sum::<f64>() / tail.len() as f64;
+    assert!(
+        q.out_of_sample_mse < 0.5 * variance,
+        "{} vs {variance}",
+        q.out_of_sample_mse
+    );
+
+    let mut future = model.clone();
+    for v in &mut future.series[model.train_len..] {
+        *v *= 10.0;
+    }
+    let again = future.run_experiment()?;
+    assert_eq!(
+        again.quantum().in_sample_mse.to_bits(),
+        q.in_sample_mse.to_bits()
+    );
+    assert_eq!(
+        again.classical().in_sample_mse.to_bits(),
+        c.in_sample_mse.to_bits()
+    );
+    assert_eq!(
+        again.classical_candidates(),
+        experiment.classical_candidates()
+    );
+    assert_ne!(
+        again.quantum().out_of_sample_mse.to_bits(),
+        q.out_of_sample_mse.to_bits()
+    );
+    Ok(())
+}
+
+#[test]
+fn a_reservoir_with_too_little_out_of_time_data_is_refused() {
+    let mut short = reservoir();
+    short.train_len = short.series.len() - 2;
+    assert!(short.validate().is_err());
+    assert!(reservoir().validate().is_ok(), "premise");
+}
