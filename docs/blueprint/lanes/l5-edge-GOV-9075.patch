+// R12-GOV-9075 (GCP v2.1 §13): the learning agent proposes capability
+// changes and never promotes one. Its grant is the proposals directory, so a
+// change from it to a promotion gate — the deploy workflow, the strategy
+// lifecycle's promotion code, the agent policy itself — is refused by the
+// role check before any review is weighed. Mutation: widen learning-agent's
+// may_edit to "docs/**" plus "backend/**", or skip the role check.
+test("a learning agent's proposal is admitted and its edit to a promotion gate is refused", () => {
+  const judge = (files) => judgeChange({
+    policy: POLICY, permissions: PERMS, headRef: "claude/learn", headSha: HEAD,
+    files, commits: [agentCommit("learning-agent")], reviews: [approval("dana")],
+  });
+  // Premise: the role exists and its own paths pass with nothing protected.
+  assert.equal(POLICY.roles["learning-agent"]?.kind, "coder");
+  assert.deepEqual(judge(["docs/proposals/2026-10-30-fill-model-recalibration.md"]).refusals, []);
+  for (const gate of [
+    ".github/workflows/deploy.yml",
+    "backend/crates/services/qip-lifecycle/src/gate.rs",
+    "scripts/agent-policy.json",
+  ]) {
+    const { agent, refusals } = judge(["docs/proposals/x.md", gate]);
+    assert.ok(agent);
+    assert.ok(
+      refusals.some((r) => r.includes("learning-agent role (coder) may not change") && r.includes(gate)),
+      `${gate}: ${JSON.stringify(refusals)}`,
+    );
+  }
+});
