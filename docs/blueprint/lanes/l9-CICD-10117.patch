@@ -1006,6 +1003,69 @@ jobs:
           fi
           echo "two builds of ${DEPLOY_SHA} are the same image: ${first}"
 
+      # The portal's second build, compared file by file (R12-CICD-10117).
+      #
+      # Two `next build`s of one tree with one epoch differ in exactly four
