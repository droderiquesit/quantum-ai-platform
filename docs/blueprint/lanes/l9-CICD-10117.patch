+            --file "${{ matrix.dockerfile }}" \
+            --output "type=docker,dest=${RUNNER_TEMP}/${{ matrix.binary }}-rebuild.tar,rewrite-timestamp=true" \
+            --label "org.opencontainers.image.revision=${DEPLOY_SHA}" \
+            --label "org.opencontainers.image.source=https://github.com/${{ github.repository }}" \
+            --tag "qip-reproducibility/${{ matrix.binary }}:${DEPLOY_SHA}" \
+            "${{ matrix.context }}"
+          docker load --input "${RUNNER_TEMP}/${{ matrix.binary }}-rebuild.tar"
+          trees="$RUNNER_TEMP/portal-trees"
