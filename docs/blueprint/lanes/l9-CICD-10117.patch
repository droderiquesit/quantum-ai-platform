+            [ "$which" = first ] || ref="qip-reproducibility/${{ matrix.binary }}:${DEPLOY_SHA}"
+            mkdir -p "$trees/$which"
+            container="$(docker create "$ref")"
+            docker export "$container" | sudo tar --extract --same-permissions --directory "$trees/$which" --file -
+            docker rm "$container" >/dev/null
+          done
