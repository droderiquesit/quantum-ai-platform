# l3-r1-01: carry the desk mandate's risk tolerance to the three roots (ADR 0405)
#
# NOT APPLIED. `infrastructure/terraform/variables.tf` is a protected path
# (scripts/agent-policy.json), and `catalogue.tf` cannot reference a variable
# that does not exist, so both halves are here and neither is committed.
#
# What it does: adds the root variable `desk_risk_tolerance` (string, default
# null, validated as a fraction from 0 to 1) and sets QIP_DESK_RISK_TOLERANCE
# on qip-api, qip-fastbrain and qip-deepbrain only when the variable is not
# null. With the default, no workload's environment changes, and the binaries
# run at a tolerance of one: the operator's limit set exactly as written.
#
# What it does not do: set a figure. No tfvars file is touched; the tolerance
# is a person's to give, per environment.
#
# NOT VALIDATED: no terraform binary exists in the session that wrote this, so
# `terraform fmt -check`, `terraform validate` and the plan that proves the
# validation refuses "1.5" and admits "0.5" have NOT been run. Whoever applies
# this runs all three, and the `infrastructure` and `terraform_contract`
# acceptance suites, before committing. Checked only: `git apply --check`
# against the tree at the commit that adds this file.
#
# Apply from the repository root: git apply <this file>
#
diff --git a/infrastructure/terraform/catalogue.tf b/infrastructure/terraform/catalogue.tf
index 3c260acf..026f523d 100644
--- a/infrastructure/terraform/catalogue.tf
+++ b/infrastructure/terraform/catalogue.tf
@@ -40,6 +40,17 @@
 #     The day there is, it is a `RunJob` manifest beside the services and an
 #     identity from the same module.
 
+# ADR 0405: QIP_DESK_RISK_TOLERANCE reaches the three roots that assemble a
+# platform (qip-api, qip-fastbrain, qip-deepbrain) only when the environment
+# states a tolerance. Null sets nothing, and an unset variable is a tolerance
+# of one in the binary: the operator's limit set in force exactly as written.
+# A value here can only narrow; the binary refuses anything outside [0, 1].
+locals {
+  desk_risk_tolerance_env = var.desk_risk_tolerance == null ? {} : {
+    QIP_DESK_RISK_TOLERANCE = var.desk_risk_tolerance
+  }
+}
+
 locals {
   # The listener every workload with a proxy reaches Google APIs through.
   # Read from the proxy module so the port is written once, in the bootstrap.
@@ -324,6 +335,9 @@ locals {
         module.secrets.console_service_account_email == null ? "" : "serviceAccount:${module.secrets.console_service_account_email}",
       ])
       env = merge(
+        # ADR 0405: the desk mandate's risk tolerance, when the environment
+        # states one. Absent, the binary runs the operator's limits exactly.
+        local.desk_risk_tolerance_env,
         {
           QIP_API_ADDRESS    = "0.0.0.0:8080"
           QIP_STORAGE_TARGET = var.storage_target
@@ -498,6 +512,9 @@ locals {
       # policy queries are recorded here.
       metrics_collector = true
       env = merge(
+        # ADR 0405: the desk mandate's risk tolerance, when the environment
+        # states one. Absent, the binary runs the operator's limits exactly.
+        local.desk_risk_tolerance_env,
         {
           QIP_FASTBRAIN_HEALTH_ADDRESS = "0.0.0.0:8080"
           QIP_STORAGE_TARGET           = var.storage_target
@@ -600,6 +617,9 @@ locals {
       # fast brain records from its own cycle.
       metrics_collector = true
       env = merge(
+        # ADR 0405: the desk mandate's risk tolerance, when the environment
+        # states one. Absent, the binary runs the operator's limits exactly.
+        local.desk_risk_tolerance_env,
         {
           QIP_DEEPBRAIN_HEALTH_ADDRESS = "0.0.0.0:8080"
           QIP_STORAGE_TARGET           = var.storage_target
diff --git a/infrastructure/terraform/variables.tf b/infrastructure/terraform/variables.tf
index 92bf6c11..5e7389b7 100644
--- a/infrastructure/terraform/variables.tf
+++ b/infrastructure/terraform/variables.tf
@@ -2169,3 +2169,30 @@ variable "secondary_region" {
     error_message = "secondary_region equals region; a secondary repository in the primary's region is lost with it. Name another region, or leave it null."
   }
 }
+
+variable "desk_risk_tolerance" {
+  description = <<-EOT
+    The desk mandate's risk tolerance, a decimal fraction from 0 to 1, as a
+    string (ADR 0405). Every maximum in the operator's limit set is in force
+    at this fraction of its ceiling; every minimum stays where the operator
+    put it. It can only narrow.
+
+    Null by default, which sets no QIP_DESK_RISK_TOLERANCE on any workload:
+    the binaries then run at a tolerance of one, the operator's limits exactly
+    as written. The figure is a person's to give; none is committed here.
+  EOT
+  type        = string
+  default     = null
+
+  validation {
+    # Refused at plan time as well as at start-up. The binary stops on a value
+    # outside the range, so an environment applied with one would be a
+    # platform that does not start; the plan is the cheaper place to learn it.
+    condition = var.desk_risk_tolerance == null ? true : (
+      can(tonumber(var.desk_risk_tolerance)) &&
+      try(tonumber(var.desk_risk_tolerance) >= 0, false) &&
+      try(tonumber(var.desk_risk_tolerance) <= 1, false)
+    )
+    error_message = "desk_risk_tolerance must be a decimal fraction from 0 to 1 written as a string, such as \"0.5\" (divide a percentage by 100), or null to run the operator's limits exactly as written."
+  }
+}
