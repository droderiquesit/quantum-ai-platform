# Algorik — environment configuration.
#
# Names and safe examples only. No live value belongs in this file or in any
# file that is committed. Private credentials (OAuth client secrets, signing
# keys, service credentials) live in Google Secret Manager and are mounted as
# files; they never appear as environment variables, because a value in the
# environment is a value in /proc/<pid>/environ, in every child process, and
# in every crash dump.
#
# Copy to `.env.local` (git-ignored) for local development.

# Which deployment this surface talks to: local | development | test | stage | production
ALGORIK_ENV=local

# Displayed posture: simulation | paper | stage | live
# `live` is never selected here. It renders only when the platform itself
# reports a live capability, and it renders as an alarm.
ALGORIK_POSTURE=paper

# --- Surface URLs -----------------------------------------------------------
# Before algorik.ai is connected these hold the URLs Google actually returns
# from a deployment. They are never invented: a URL appears here only after a
# deploy prints it. See docs/operations/algorik-domain-migration.md.
ALGORIK_SITE_URL=http://127.0.0.1:3000
ALGORIK_PORTAL_URL=http://127.0.0.1:3400
ALGORIK_ADMIN_URL=http://127.0.0.1:3500
ALGORIK_API_URL=http://127.0.0.1:3400/api

# --- Identity Platform ------------------------------------------------------
# Leave the project id empty to use the local development identity adapter,
# which needs no Google project. Setting it switches the surfaces to the
# Identity Platform adapter and then the other three become required.
ALGORIK_IDENTITY_PROJECT_ID=
ALGORIK_IDENTITY_API_KEY=
ALGORIK_IDENTITY_REDIRECT_URI=
ALGORIK_GOOGLE_CLIENT_ID=
ALGORIK_AUTHORIZED_DOMAINS=localhost,127.0.0.1

# --- The platform behind the BFF -------------------------------------------
# Server-side only. The browser never learns this address.
QIP_API_BASE_URL=http://127.0.0.1:8080
QIP_API_TIMEOUT_MS=10000

# --- Sessions and the authentication gate ----------------------------------
# Signing key for session cookies. At least 32 characters. Required in
# production — a process that invented one would issue sessions no other
# replica could verify. Generate: openssl rand -base64 48
ALGORIK_SESSION_SECRET=

# Gate the portal behind sign-in. Off by default: the console predates
# accounts and open (kiosk) deployments are legitimate.
ALGORIK_AUTH_REQUIRED=false

# Where the development identity store writes its JSON. Git-ignored.
ALGORIK_IDENTITY_STORE_DIR=.algorik-dev
